  <mxGeometry x="725" y="230" width="125" height="75" as="geometry" />
</mxCell><mxCell id="b_telegram" value="&lt;b&gt;Bot Telegram&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(/api/telegram/realisasi)&lt;/i&gt;&lt;br/&gt;Input cepat realisasi &amp;amp; rijek operator via HP" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;spacing=5;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;align=left;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=8;" vertex="1" parent="1">
  <mxGeometry x="865" y="230" width="125" height="75" as="geometry" />
</mxCell><mxCell id="b_jhp" value="&lt;b&gt;Jurnal Harian Produksi (JHP) (/jurnal-harian-produksi)&lt;/b&gt; [INTI PABRIK]&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;1. Penjadwalan Shift:&lt;/b&gt; Bagian (Cetak, Finishing, Setting, QC), Shift 1/2/3, Operator (Karyawan), No SOPd, Target&lt;br/&gt;• &lt;b&gt;2. Input Realisasi:&lt;/b&gt; Jam Kerja (Mulai - Selesai) &amp;amp; Lembar Cetak Berhasil&lt;br/&gt;• &lt;b&gt;3. Fitur Cek Karyawan:&lt;/b&gt; Pantau staf yang sudah vs belum dapat tugas kerja&lt;br/&gt;• &lt;b&gt;4. Pencatatan Rijek:&lt;/b&gt; Rusak cetak afdruk/jalan, Inscheet &amp;amp; kendala teknis mesin" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;spacing=5;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;align=left;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=2;" vertex="1" parent="1">
  <mxGeometry x="585" y="355" width="405" height="125" as="geometry" />
</mxCell><mxCell id="b_target_harian" value="&lt;b&gt;Target Harian (/jurnal-harian-produksi/target)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;Rekap capaian target shift hari ini per bagian &amp;amp; operator" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;spacing=5;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;align=left;fillColor=#ffffff;strokeColor=#db2777;" vertex="1" parent="1">
