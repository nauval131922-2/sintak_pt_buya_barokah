        <mxCell id="h2_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#1e293b;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2580" height="60" as="geometry" /></mxCell><mxCell id="h2_txt" value="DIAGRAM SIKLUS HIDUP &amp; STATUS TRANSAKSI (STATE MACHINE) SISTEM SINTAK&#10;PT BUYA BAROKAH" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2580" height="60" as="geometry" /></mxCell><mxCell id="c1_bg" value="1. SIKLUS TUGAS LAPANGAN (LAPORAN PEKERJAAN)&#10;Tabel: laporan_pekerjaan (5.194 baris)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;strokeWidth=2;align=center;verticalAlign=top;spacingTop=12;fontStyle=1;fontSize=12;fillColor=#f8fafc;strokeColor=#0284c7;fontColor=#0369a1;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="380" height="740" as="geometry" /></mxCell><mxCell id="s1_init" value="1. INPUT TUGAS BARU&#10;• Sumber: Web Inline Form / Telegram&#10;• Divisi: Setting, QC, Cetak, Finishing, Gudang, Teknisi, Mesin" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#f0f9ff;strokeColor=#0284c7;fontColor=#0369a1;" vertex="1" parent="1"><mxGeometry x="65" y="175" width="330" height="65" as="geometry" /></mxCell><mxCell id="s1_pending" value="STATUS: 'BELUM DIKERJAKAN'&#10;• Task terdaftar di antrean PIC divisi&#10;• Prioritas: Normal / Urgent / High" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;" vertex="1" parent="1"><mxGeometry x="65" y="290" width="330" height="65" as="geometry" /></mxCell><mxCell id="s1_prog" value="STATUS: 'IN PROGRESS'&#10;• PIC mulai pengerjaan fisik&#10;• Waktu mulai tercatat (start_date)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="65" y="405" width="330" height="65" as="geometry" /></mxCell><mxCell id="s1_done" value="STATUS: 'SELESAI'&#10;• Pekerjaan tuntas &amp; verifikasi QC/Kasi&#10;• Tanggal rampung (end_date, work_days)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="65" y="520" width="330" height="65" as="geometry" /></mxCell><mxCell id="s1_cancel" value="STATUS: 'CANCEL'&#10;• Dibatalkan / revisi spesifikasi pesanan&#10;• Keterangan alasan di kolom 'note'" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="65" y="635" width="330" height="65" as="geometry" /></mxCell><mxCell id="e1_1" value="Penugasan Tugas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#0284c7;" edge="1" parent="1" source="s1_init" target="s1_pending"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_2" value="Mulai Pengerjaan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#0284c7;" edge="1" parent="1" source="s1_pending" target="s1_prog"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_3" value="Rampung &amp; Diserahkan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#16a34a;" edge="1" parent="1" source="s1_prog" target="s1_done"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_4" value="Pembatalan / Drop Order" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#dc2626;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s1_pending" target="s1_cancel"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="322" /><mxPoint x="20" y="667" /></Array></mxGeometry></mxCell><mxCell id="c2_bg" value="2. SIKLUS ORDER PRODUKSI &amp; JHP SHIFT&#10;Tabel: orders, sopd, sopd_harga, jurnal_harian_produksi" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;strokeWidth=2;align=center;verticalAlign=top;spacingTop=12;fontStyle=1;fontSize=12;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="480" y="105" width="380" height="740" as="geometry" /></mxCell><mxCell id="s2_in" value="1. PESANAN MASUK (ORDERS / SOPd)&#10;• Tarik dari Digit (orders) / Impor Excel SOPd&#10;• Setting estimasi harga &amp; deadline di sopd_harga" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="505" y="175" width="330" height="65" as="geometry" /></mxCell><mxCell id="s2_sched" value="2. PENJADWALAN TARGET SHIFT&#10;• Entri tabel jurnal_harian_produksi&#10;• Penugasan: Shift 1/2/3, Operator, Mesin, Target Lembar" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#fed7aa;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="505" y="290" width="330" height="65" as="geometry" /></mxCell><mxCell id="s2_exec" value="3. REALISASI OPERATOR LAPANGAN&#10;• Input jam mulai, jam selesai, lembar jadi&#10;• Pencatatan rijek, inscheet &amp; kendala kerja" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#fef08a;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="505" y="405" width="330" height="65" as="geometry" /></mxCell><mxCell id="s2_finish" value="4. STATUS FINISHED (SELESAI PRODUKSI)&#10;• sopd_harga.finished_date terisi tanggal selesai&#10;• Validasi: EXISTS (SELECT 1 FROM produksi_selesai)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="505" y="520" width="330" height="65" as="geometry" /></mxCell><mxCell id="s2_bj" value="5. SERAH TERIMA GUDANG (BARANG JADI)&#10;• Tabel barang_jadi (faktur_prd, faktur_so)&#10;• Produk siap dikirimkan ke pelanggan" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#a7f3d0;strokeColor=#059669;fontColor=#064e3b;" vertex="1" parent="1"><mxGeometry x="505" y="635" width="330" height="65" as="geometry" /></mxCell><mxCell id="e2_1" value="Plotting Antrean" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#ea580c;" edge="1" parent="1" source="s2_in" target="s2_sched"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_2" value="Eksekusi Mesin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#ea580c;" edge="1" parent="1" source="s2_sched" target="s2_exec"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_3" value="Tuntas Cetak &amp; Finishing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#16a34a;" edge="1" parent="1" source="s2_exec" target="s2_finish"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_4" value="Masuk Gudang Jadi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#059669;" edge="1" parent="1" source="s2_finish" target="s2_bj"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c3_bg" value="3. SIKLUS PENGADAAN BAHAN BAKU&#10;Tabel: purchase_requests s/d pelunasan_hutang" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;strokeWidth=2;align=center;verticalAlign=top;spacingTop=12;fontStyle=1;fontSize=12;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="920" y="105" width="380" height="740" as="geometry" /></mxCell><mxCell id="s3_req" value="1. PENGAJUAN BELANJA (PR &amp; SPPH)&#10;• purchase_requests (faktur RQ, status=1)&#10;• spph_out: Permintaan penawaran ke supplier" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="945" y="175" width="330" height="65" as="geometry" /></mxCell><mxCell id="s3_po" value="2. KONTRAK PEMBELIAN RESMI (PO)&#10;• sph_in (Penawaran Masuk) → purchase_orders&#10;• PO resmi terbit ke vendor (status=1)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="945" y="290" width="330" height="65" as="geometry" /></mxCell><mxCell id="s3_rcv" value="3. PENERIMAAN FISIK DI GUDANG&#10;• penerimaan_pembelian (RI): status=0 / 1&#10;• 0: Diterima Sebagian | 1: Diterima Lengkap" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#86efac;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="945" y="405" width="330" height="65" as="geometry" /></mxCell><mxCell id="s3_inv" value="4. PENGAKUAN HUTANG (FAKTUR PB)&#10;• rekap_pembelian_barang (PB...)&#10;• Pencatatan hutang dagang &amp; stok masuk" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#fef08a;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="945" y="520" width="330" height="65" as="geometry" /></mxCell><mxCell id="s3_pay" value="5. PELUNASAN HUTANG VENDOR (PH)&#10;• pelunasan_hutang (PH...): kas / bank&#10;• Status transaksi: LUNAS" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#a7f3d0;strokeColor=#059669;fontColor=#064e3b;" vertex="1" parent="1"><mxGeometry x="945" y="635" width="330" height="65" as="geometry" /></mxCell><mxCell id="e3_1" value="Persetujuan Vendor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#16a34a;" edge="1" parent="1" source="s3_req" target="s3_po"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_2" value="Kedatangan Barang" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#16a34a;" edge="1" parent="1" source="s3_po" target="s3_rcv"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_3" value="Verifikasi Invoice" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#ca8a04;" edge="1" parent="1" source="s3_rcv" target="s3_inv"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_4" value="Pembayaran Kas/Bank" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#059669;" edge="1" parent="1" source="s3_inv" target="s3_pay"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c4_bg" value="4. SIKLUS PENJUALAN &amp; PENGIRIMAN&#10;Tabel: sph_out, sales_orders, sales_reports, pengiriman" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;strokeWidth=2;align=center;verticalAlign=top;spacingTop=12;fontStyle=1;fontSize=12;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="1360" y="105" width="380" height="740" as="geometry" /></mxCell><mxCell id="s4_so" value="1. PENAWARAN &amp; SALES ORDER&#10;• sph_out (QO...) → sales_orders (SO...)&#10;• Pesanan terkonfirmasi pelanggan" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="1385" y="175" width="330" height="65" as="geometry" /></mxCell><mxCell id="s4_inv" value="2. PENERBITAN FAKTUR SI (SALES REPORT)&#10;• sales_reports (SI...)&#10;• Pengakuan piutang dagang &amp; dasar penagihan" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#fef08a;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="1385" y="290" width="330" height="65" as="geometry" /></mxCell><mxCell id="s4_ship" value="3. STATUS SURAT JALAN: 'Dikirim'&#10;• pengiriman: status_faktur = 'Dikirim'&#10;• Supir, armada, dan nomor resi tercatat" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#fed7aa;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="1385" y="405" width="330" height="65" as="geometry" /></mxCell><mxCell id="s4_deliv" value="4. STATUS SURAT JALAN: 'Terkirim'&#10;• pengiriman: status_faktur = 'Terkirim'&#10;• Produk fisik diterima aman oleh konsumen" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="1385" y="520" width="330" height="65" as="geometry" /></mxCell><mxCell id="s4_settle" value="5. PELUNASAN PIUTANG (PT)&#10;• pelunasan_piutang (fkt = sales_reports.faktur)&#10;• Pembayaran lunas via transfer / kas" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#a7f3d0;strokeColor=#059669;fontColor=#064e3b;" vertex="1" parent="1"><mxGeometry x="1385" y="635" width="330" height="65" as="geometry" /></mxCell><mxCell id="e4_1" value="Penerbitan Invoice" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#ca8a04;" edge="1" parent="1" source="s4_so" target="s4_inv"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_2" value="Muat Armada &amp; Berangkat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#ea580c;" edge="1" parent="1" source="s4_inv" target="s4_ship"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_3" value="Serah Terima Pelanggan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#16a34a;" edge="1" parent="1" source="s4_ship" target="s4_deliv"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_4" value="Penyelesaian Tagihan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#059669;" edge="1" parent="1" source="s4_deliv" target="s4_settle"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c5_bg" value="5. SIKLUS KEDISIPLINAN SDM&#10;Tabel: employees, infractions (Catat Kesalahan)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;strokeWidth=2;align=center;verticalAlign=top;spacingTop=12;fontStyle=1;fontSize=12;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#881337;" vertex="1" parent="1"><mxGeometry x="1800" y="105" width="380" height="740" as="geometry" /></mxCell><mxCell id="s5_emp" value="1. MASTER KARYAWAN AKTIF&#10;• employees: is_active = 1&#10;• NIP, nama, posisi, departemen terdaftar" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;" vertex="1" parent="1"><mxGeometry x="1825" y="175" width="330" height="65" as="geometry" /></mxCell><mxCell id="s5_inc" value="2. INSIDEN KESALAHAN KERJA&#10;• Terjadi afkir cetak, salah potong, plat rusak&#10;• Pelaporan ke menu /records (terikat No Order)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#fecdd3;strokeColor=#e11d48;fontColor=#881337;" vertex="1" parent="1"><mxGeometry x="1825" y="290" width="330" height="65" as="geometry" /></mxCell><mxCell id="s5_low" value="3. SEVERITY: 'Low'&#10;• Kesalahan operasional minor / non-fatal&#10;• Sanksi teguran &amp; evaluasi pembinaan shift" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#fef08a;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="1825" y="405" width="330" height="65" as="geometry" /></mxCell><mxCell id="s5_med" value="4. SEVERITY: 'Medium'&#10;• Kerusakan material signifikan (kertas/plat/tinta)&#10;• Pembebanan nilai ganti rugi finansial staf" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="1825" y="520" width="330" height="65" as="geometry" /></mxCell><mxCell id="s5_eval" value="5. EVALUASI BULANAN DI DASHBOARD HRD&#10;• /dashboard-hrd: Tren insiden per divisi&#10;• Rekapitulasi pemotongan atau kompensasi" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#f3e8ff;strokeColor=#7c3aed;fontColor=#581c87;" vertex="1" parent="1"><mxGeometry x="1825" y="635" width="330" height="65" as="geometry" /></mxCell><mxCell id="e5_1" value="Terjadi Kelalaian" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#e11d48;" edge="1" parent="1" source="s5_emp" target="s5_inc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5_2a" value="Klasifikasi Minor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#ca8a04;" edge="1" parent="1" source="s5_inc" target="s5_low"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5_2b" value="Klasifikasi Material" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#dc2626;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s5_inc" target="s5_med"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2210" y="322" /><mxPoint x="2210" y="552" /></Array></mxGeometry></mxCell><mxCell id="e5_3a" value="Rekap HRD" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#7c3aed;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s5_low" target="s5_eval"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1770" y="437" /><mxPoint x="1770" y="667" /></Array></mxGeometry></mxCell><mxCell id="e5_3b" value="Rekap HRD" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#7c3aed;" edge="1" parent="1" source="s5_med" target="s5_eval"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c6_bg" value="6. TATA KELOLA PENGGUNA &amp; BOT&#10;Tabel: users, app_roles, telegram_users" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;strokeWidth=2;align=center;verticalAlign=top;spacingTop=12;fontStyle=1;fontSize=12;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="2240" y="105" width="380" height="740" as="geometry" /></mxCell><mxCell id="s6_user_init" value="1. REGISTRASI AKUN PENGGUNA&#10;• Input username, nama, tautkan NIP karyawan&#10;• Set password bcrypt &amp; pilih Peran (app_roles)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="2265" y="175" width="330" height="65" as="geometry" /></mxCell><mxCell id="s6_user_act" value="2. STATUS AKUN: is_active = 1&#10;• User dapat login sesuai izin role_permissions&#10;• Akses modul dibatasi secara otomatis (RBAC)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="2265" y="290" width="330" height="65" as="geometry" /></mxCell><mxCell id="s6_bot_reg" value="3. PENDAFTARAN BOT TELEGRAM&#10;• Operator menghubungkan ID Telegram ke bot&#10;• Status awal: is_active = 0 (Menunggu Otorisasi)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#fef08a;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="2265" y="405" width="330" height="65" as="geometry" /></mxCell><mxCell id="s6_bot_appr" value="4. APPROVAL BOT TELEGRAM&#10;• Super Admin menyetujui akun di /settings/telegram-users&#10;• Status berubah: is_active = 1 (Approved)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#a7f3d0;strokeColor=#059669;fontColor=#064e3b;" vertex="1" parent="1"><mxGeometry x="2265" y="520" width="330" height="65" as="geometry" /></mxCell><mxCell id="s6_audit" value="5. AUDIT JEJAK SISTEM (ACTIVITY LOGS)&#10;• Setiap aksi CRUD tercatat otomatis di activity_logs&#10;• Pemantauan di /log-aktivitas" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="2265" y="635" width="330" height="65" as="geometry" /></mxCell><mxCell id="e6_1" value="Aktivasi Akun" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#2563eb;" edge="1" parent="1" source="s6_user_init" target="s6_user_act"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6_2" value="Pendaftaran Bot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#ca8a04;" edge="1" parent="1" source="s6_user_act" target="s6_bot_reg"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6_3" value="Verifikasi Admin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#059669;" edge="1" parent="1" source="s6_bot_reg" target="s6_bot_appr"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6_4" value="Perekaman Audit Trail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#475569;" edge="1" parent="1" source="s6_bot_appr" target="s6_audit"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
