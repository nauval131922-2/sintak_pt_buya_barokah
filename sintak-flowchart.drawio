  <mxGeometry x="1735" y="370" width="400" height="100" as="geometry" />
</mxCell><mxCell id="b_excel_hpp" value="&lt;b&gt;Upload Excel HPP&lt;/b&gt; (&lt;code&gt;/settings/konversi-data/.../hpp&lt;/code&gt;)&lt;br/&gt;Upload arsip Excel kalkulasi HPP masa lalu" style="rounded=1;whiteSpace=wrap;html=1;fontSize=8;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;align=left;fillColor=#ffffff;strokeColor=#d97706;dashed=1;align=center;" vertex="1" parent="1">
