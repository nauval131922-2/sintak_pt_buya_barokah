  <mxGeometry x="1710" y="125" width="450" height="840" as="geometry" />
</mxCell><mxCell id="b_gsheet_laporan" value="&lt;b&gt;Google Spreadsheet (DATABASE_REPORT)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;Konversi Data Awal via &lt;code&gt;/settings/konversi-data/laporan-pekerjaan&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=8;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;align=left;fillColor=#f0fdf4;strokeColor=#16a34a;dashed=1;align=center;" vertex="1" parent="1">
  <mxGeometry x="1735" y="165" width="400" height="50" as="geometry" />
</mxCell><mxCell id="t_laporan_kerja" value="&lt;b&gt;laporan_pekerjaan&lt;/b&gt; (5.194 baris) [MODUL TERPISAH]&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Kolom:&lt;/b&gt; &lt;code&gt;task, project, division, bagian, pic, priority, start_date, end_date, work_days...&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Web Form Harian:&lt;/b&gt; Log pengerjaan 7 divisi (Setting, QC, Cetak, Finishing, Gudang, Teknisi, Mesin)&lt;br/&gt;• &lt;b&gt;Status Transaksi:&lt;/b&gt; &lt;code&gt;status&lt;/code&gt; ('BELUM DIKERJAKAN', 'IN PROGRESS', 'SELESAI', 'CANCEL')&lt;br/&gt;• &lt;i&gt;*Hak akses divisi diatur di &lt;code&gt;role_laporan_pekerjaan_config&lt;/code&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=8;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;align=left;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=1.5;" vertex="1" parent="1">
  <mxGeometry x="1735" y="240" width="400" height="85" as="geometry" />
