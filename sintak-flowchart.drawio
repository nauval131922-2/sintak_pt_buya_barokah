  <diagram id="sintak-simple-flowchart" name="Flowchart SINTAK">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1095" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner" value="&lt;b&gt;FLOWCHART LENGKAP SISTEM SINTAK (STRUKTUR VALIDASI KODE &amp;amp; SUMBER DATA NYATA)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size: 11px; font-weight: normal; color: #475569;&#x27;&gt;Pemetaan Komprehensif Berdasarkan Logika Kode Asli: Upload Excel, Google Spreadsheet Live Sync, Master Karyawan Feeder JHP, dan Alur Kerja Pabrik&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="40" y="20" width="2360" height="55" as="geometry" />
</mxCell><mxCell id="bg_col1" value="&lt;b&gt;1. INTEGRASI ERP &amp;amp; TRANSAKSI DIGIT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=12;fontSize=11.5;fontStyle=1;strokeWidth=1.5;fillColor=#f0f9ff;strokeColor=#bae6fd;fontColor=#0369a1;" vertex="1" parent="1">
  <mxGeometry x="40" y="95" width="490" height="960" as="geometry" />
</mxCell><mxCell id="b_digit" value="&lt;b&gt;DIGIT ERP (Sistem Eksternal)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;Pusat data master perusahaan:&lt;br/&gt;Order Penjualan (SO), Stok Barang, PR/PO, Pembelian &amp;amp; Keuangan" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="65" y="135" width="440" height="75" as="geometry" />
</mxCell><mxCell id="b_sync" value="&lt;b&gt;Sinkronisasi All Data (/sync)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;Menjalankan scraper untuk menarik batch data dari Digit ke database lokal SQLite SINTAK" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;spacing=5;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;align=left;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;" vertex="1" parent="1">
  <mxGeometry x="65" y="255" width="440" height="60" as="geometry" />
</mxCell><mxCell id="b_digit_modules" value="&lt;b&gt;Seluruh Modul Transaksi Digit di SINTAK (18 Menu):&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Stok:&lt;/b&gt; Master Barang (&lt;code&gt;/data-digit/stok/master-barang&lt;/code&gt;)&lt;br/&gt;• &lt;b&gt;Pembelian (7 Menu):&lt;/b&gt; PR (&lt;code&gt;/pr&lt;/code&gt;), SPPH Keluar (&lt;code&gt;/spph-out&lt;/code&gt;), SPH Masuk (&lt;code&gt;/sph-in&lt;/code&gt;), PO (&lt;code&gt;/purchase-orders&lt;/code&gt;), Penerimaan Barang (&lt;code&gt;/penerimaan-pembelian&lt;/code&gt;), Rekap Pembelian (&lt;code&gt;/rekap-pembelian-barang&lt;/code&gt;), Pelunasan Hutang (&lt;code&gt;/pelunasan-hutang&lt;/code&gt;)&lt;br/&gt;• &lt;b&gt;Penjualan (5 Menu):&lt;/b&gt; SPH Keluar (&lt;code&gt;/sph-out&lt;/code&gt;), Sales Order (&lt;code&gt;/sales-orders&lt;/code&gt;), Laporan Penjualan (&lt;code&gt;/sales&lt;/code&gt;), Pelunasan Piutang (&lt;code&gt;/pelunasan-piutang&lt;/code&gt;), Pengiriman (&lt;code&gt;/pengiriman&lt;/code&gt;)&lt;br/&gt;• &lt;b&gt;Akuntansi (2 Menu):&lt;/b&gt; Rek Akuntansi (&lt;code&gt;/akuntansi/data/rek-akuntansi&lt;/code&gt;) &amp;amp; Jurnal Umum (&lt;code&gt;/akuntansi/laporan/jurnal-umum&lt;/code&gt;)&lt;br/&gt;• &lt;b&gt;Produksi Digit (5 Menu):&lt;/b&gt; BOM (&lt;code&gt;/bom&lt;/code&gt;), Order SPK (&lt;code&gt;/orders&lt;/code&gt;), Produksi Selesai (&lt;code&gt;/data-digit/produksi/produksi-selesai&lt;/code&gt;), BBB (&lt;code&gt;/bahan-baku&lt;/code&gt;), Penerimaan Barang Jadi (&lt;code&gt;/barang-jadi&lt;/code&gt;)&lt;br/&gt;• &lt;b&gt;Sistem:&lt;/b&gt; Log Aktivitas User Digit (&lt;code&gt;/data-digit/sistem/log-aktivitas-user&lt;/code&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;spacing=5;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;align=left;fillColor=#ffffff;strokeColor=#0284c7;fontSize=8.5;" vertex="1" parent="1">
  <mxGeometry x="65" y="365" width="440" height="195" as="geometry" />
</mxCell><mxCell id="b_tracking" value="&lt;b&gt;Tracking Manufaktur (/tracking-manufaktur)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;Melacak status siklus hidup dokumen manufaktur dari hulu ke hilir:&lt;br/&gt;&lt;code&gt;Sales Order &amp;rarr; SPK &amp;rarr; BOM &amp;rarr; PR/PO &amp;rarr; Penerimaan Barang &amp;rarr; BBB &amp;rarr; Kirim (SJ) &amp;rarr; Pelunasan Piutang&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;spacing=5;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;align=left;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=2;" vertex="1" parent="1">
  <mxGeometry x="65" y="610" width="440" height="95" as="geometry" />
