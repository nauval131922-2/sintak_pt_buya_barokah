        <mxCell id="banner" value="&lt;b&gt;PETA ARSITEKTUR RELASI DATABASE &amp;amp; ALIRAN SISTEM SINTAK&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size: 11px; font-weight: normal; color: #475569;'&gt;Visualisasi Tabel Individual Digit &amp;amp; SINTAK: Primary Key (PK), Foreign Key (FK), Hubungan Lintas Modul, Multi-Source Input, dan Jalur Manufaktur&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="40" y="20" width="2660" height="55" as="geometry" />
</mxCell><mxCell id="bg_col1" value="&lt;b&gt;1. PENCERMINAN PEMBELIAN &amp;amp; STOK (READ-ONLY DIGIT ERP)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size: 9.5px; font-weight: normal; color: #0369a1;'&gt;Sinkronisasi &amp;amp; live scraper data pengadaan Digit untuk viewer, tracking manufaktur &amp;amp; lookup tarif pricelist&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=12;fontSize=11.5;fontStyle=1;strokeWidth=1.5;fillColor=#f0f9ff;strokeColor=#bae6fd;fontColor=#0369a1;" vertex="1" parent="1">
  <mxGeometry x="40" y="125" width="450" height="840" as="geometry" />
</mxCell><mxCell id="t_stok" value="&lt;b&gt;stok_master_barang&lt;/b&gt; (12.958 baris)&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;PK:&lt;/b&gt; &lt;code&gt;kode&lt;/code&gt; | &lt;b&gt;Barcode:&lt;/b&gt; &lt;code&gt;barcode&lt;/code&gt;&lt;br/&gt;• Data: nama barang, satuan, saldo awal/akhir, harga jual, kelompok" style="rounded=1;whiteSpace=wrap;html=1;fontSize=8;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;align=left;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;" vertex="1" parent="1">
