  <diagram id="sintak-relational-architecture" name="Relasi Database &amp; Alur Sistem SINTAK">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2740" pageHeight="1000" math="0" shadow="0">
      <root>
