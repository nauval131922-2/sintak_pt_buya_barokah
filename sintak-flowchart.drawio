</mxCell><mxCell id="bg_col4" value="&lt;b&gt;4. PELAPORAN TUGAS LAPANGAN &amp;amp; SIMULATOR HARGA (NATIVE SINTAK)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size: 9.5px; font-weight: normal; color: #4c1d95;'&gt;Manajemen lembar kerja tugas 7 divisi pabrik dan simulator kalkulasi biaya cetak 20+ produk&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=12;fontSize=11.5;fontStyle=1;strokeWidth=1.5;fillColor=#fff1f2;strokeColor=#fecdd3;fontColor=#9f1239;" vertex="1" parent="1">
  <mxGeometry x="1710" y="125" width="450" height="840" as="geometry" />
</mxCell><mxCell id="b_gsheet_laporan" value="&lt;b&gt;laporan_pekerjaan (Modul Mandiri SINTAK)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;Sistem manajemen tugas 7 divisi lokal SINTAK (5.194 baris)&lt;br/&gt;&lt;i&gt;*Google Spreadsheet hanya dipakai 1x untuk auto-seed awal&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=8;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;align=left;fillColor=#f0fdf4;strokeColor=#16a34a;dashed=1;align=center;" vertex="1" parent="1">
  <mxGeometry x="1735" y="165" width="400" height="50" as="geometry" />
</mxCell><mxCell id="t_laporan_kerja" value="&lt;b&gt;laporan_pekerjaan&lt;/b&gt; (5.194 baris) [MODUL TERPISAH]&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Kolom:&lt;/b&gt; &lt;code&gt;task, project, division, bagian, pic, priority, start_date, end_date, work_days...&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Web Form Harian:&lt;/b&gt; Log pengerjaan 7 divisi (Setting, QC, Cetak, Finishing, Gudang, Teknisi, Mesin)&lt;br/&gt;• &lt;b&gt;Status Transaksi:&lt;/b&gt; &lt;code&gt;status&lt;/code&gt; ('BELUM DIKERJAKAN', 'IN PROGRESS', 'SELESAI', 'CANCEL')&lt;br/&gt;• &lt;i&gt;*Hak akses divisi diatur di &lt;code&gt;role_laporan_pekerjaan_config&lt;/code&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=8;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;align=left;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=1.5;" vertex="1" parent="1">
  <mxGeometry x="1735" y="240" width="400" height="85" as="geometry" />
</mxCell><mxCell id="m_pricelist" value="&lt;b&gt;Pricelist Simulator (/pricelist)&lt;/b&gt; [SIMULATOR MANDIRI]&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;20+ Produk:&lt;/b&gt; Buku Soft/Hard Cover, Dus, Brosur, Stopmap, Undangan, Kalender, dll.&lt;br/&gt;• &lt;b&gt;Rekap Lookup:&lt;/b&gt; Referensi tarif riil dari riwayat &lt;code&gt;rekap_pembelian_barang&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Output:&lt;/b&gt; Matriks &lt;code&gt;pricelist_items&lt;/code&gt; (216 baris) &amp;amp; simulasi &lt;code&gt;pricelist_saved_calculations&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=8;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;align=left;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=1.5;" vertex="1" parent="1">
  <mxGeometry x="1735" y="370" width="400" height="100" as="geometry" />
</mxCell><mxCell id="b_excel_hpp" value="&lt;b&gt;Upload Excel HPP&lt;/b&gt; (&lt;code&gt;/settings/konversi-data/.../hpp&lt;/code&gt;)&lt;br/&gt;Upload arsip Excel kalkulasi HPP masa lalu" style="rounded=1;whiteSpace=wrap;html=1;fontSize=8;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;align=left;fillColor=#ffffff;strokeColor=#d97706;dashed=1;align=center;" vertex="1" parent="1">
