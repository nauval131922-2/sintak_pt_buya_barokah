  <diagram id="sintak-status-lifecycle" name="Siklus Hidup &amp; Status Transaksi">
    <mxGraphModel dx="1422" dy="798" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="880" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h2_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#1e293b;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2340" height="60" as="geometry"/></mxCell><mxCell id="h2_txt" value="DIAGRAM SIKLUS HIDUP &amp; STATUS TRANSAKSI ASLI SISTEM SINTAK (STATE MACHINE)&#xa;PT BUYA BAROKAH" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2340" height="60" as="geometry"/></mxCell><mxCell id="c1_bg" value="1. SIKLUS TUGAS LAPANGAN (LAPORAN PEKERJAAN 7 DIVISI)&#xa;Tabel: laporan_pekerjaan (5.194 baris) — Native SINTAK" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;strokeWidth=2;align=center;verticalAlign=top;spacingTop=12;fontStyle=1;fontSize=12;fillColor=#f8fafc;strokeColor=#0284c7;fontColor=#0369a1;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="540" height="740" as="geometry"/></mxCell><mxCell id="s1_init" value="1. PENUGASAN TUGAS BARU&#xa;• Input via Antarmuka Web Data Table atau Pesan Bot Telegram (/api/telegram/realisasi)&#xa;• Pemilihan Divisi: Setting, QC, Cetak, Finishing, Gudang, Teknisi, Mesin" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#f0f9ff;strokeColor=#0284c7;fontColor=#0369a1;" vertex="1" parent="1"><mxGeometry x="70" y="175" width="480" height="65" as="geometry"/></mxCell><mxCell id="s1_pending" value="STATUS: &#x27;BELUM DIKERJAKAN&#x27;&#xa;• Tugas masuk ke antrean kerja PIC divisi terkait&#xa;• Pengaturan Skala Prioritas: Normal / Urgent / High (penandaan badge warna)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="480" height="65" as="geometry"/></mxCell><mxCell id="s1_prog" value="STATUS: &#x27;IN PROGRESS&#x27;&#xa;• PIC memulai pengerjaan fisik di workstation / mesin lapangan&#xa;• Sistem mencatat stempel waktu mulai kerja (start_date)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="70" y="405" width="480" height="65" as="geometry"/></mxCell><mxCell id="s1_done" value="STATUS: &#x27;SELESAI&#x27;&#xa;• Pekerjaan tuntas &amp; verifikasi QC / Kasi&#xa;• Pencatatan tanggal rampung (end_date)&#xa;• Perhitungan durasi kerja nyata (work_days)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="70" y="520" width="230" height="85" as="geometry"/></mxCell><mxCell id="s1_cancel" value="STATUS: &#x27;CANCEL&#x27;&#xa;• Dibatalkan oleh Kepala Bagian / Revisi Spek&#xa;• Catatan alasan pembatalan tersimpan di kolom &#x27;note&#x27;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="320" y="520" width="230" height="85" as="geometry"/></mxCell><mxCell id="s1_archive" value="5. ARSIP &amp; LOG KINERJA DIVISI (/laporan-pekerjaan)&#xa;• Seluruh riwayat pengerjaan tersimpan permanen di database lokal&#xa;• Evaluasi produktivitas kerja divisi dan ketepatan pemenuhan tenggat waktu" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="70" y="640" width="480" height="65" as="geometry"/></mxCell><mxCell id="e1_1" value="Penugasan PIC &amp; Divisi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#0284c7;" edge="1" parent="1" source="s1_init" target="s1_pending"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1_2" value="Mulai Pengerjaan Fisik" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#0284c7;" edge="1" parent="1" source="s1_pending" target="s1_prog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1_3a" value="Tuntas &amp; Verifikasi Lolos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#16a34a;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1_prog" target="s1_done"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1_3b" value="Dibatalkan / Revisi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#dc2626;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1_prog" target="s1_cancel"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1_4a" value="Rekap Hasil Tuntas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#16a34a;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="s1_done" target="s1_archive"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1_4b" value="Rekap Pembatalan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#dc2626;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="s1_cancel" target="s1_archive"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c2_bg" value="2. SIKLUS PENJADWALAN &amp; REALISASI PRODUKSI PABRIK&#xa;Tabel: sopd, sopd_harga, jurnal_harian_produksi — Native SINTAK" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;strokeWidth=2;align=center;verticalAlign=top;spacingTop=12;fontStyle=1;fontSize=12;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="640" y="105" width="540" height="740" as="geometry"/></mxCell><mxCell id="s2_in" value="1. ANTREAN ORDER PRODUKSI MASUK (/data/excel-sopd)&#xa;• Tarik pesanan baru dari orders Digit atau impor Excel arsip SOPd (6.603 baris)&#xa;• Admin Penjadwalan menetapkan estimasi harga dan tanggal deadline (sopd_harga)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="670" y="175" width="480" height="65" as="geometry"/></mxCell><mxCell id="s2_sched" value="2. PENYUSUNAN JADWAL TARGET SHIFT (/jurnal-harian-produksi)&#xa;• Admin menyusun jadwal: Bagian, Shift 1/2/3, Mesin, Nama Operator, Target Lembar&#xa;• Fitur &#x27;Copy Jadwal&#x27;: Duplikasi susunan shift kemarin untuk efisiensi entri" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#fed7aa;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="670" y="290" width="480" height="65" as="geometry"/></mxCell><mxCell id="s2_exec" value="3. REALISASI OPERATOR LAPANGAN (JHP REALISASI)&#xa;• Input jam mulai, jam selesai, dan jumlah lembar cetak/finishing tuntas&#xa;• Pencatatan lembar rijek (rusak setup/jalan), lembar inscheet, dan kendala mesin" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#fef08a;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="670" y="405" width="480" height="65" as="geometry"/></mxCell><mxCell id="s2_finish" value="4. PENETAPAN STATUS SELESAI (FINISHED DATE)&#xa;• Admin mengisi tanggal rampung di sopd_harga.finished_date (6.041 baris tuntas)&#xa;• Validasi status cetak: EXISTS (SELECT 1 FROM produksi_selesai)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="670" y="520" width="480" height="65" as="geometry"/></mxCell><mxCell id="s2_dash" value="5. REKAPITULASI HASIL PRODUKSI &amp; DASHBOARD MANUFAKTUR&#xa;• Akumulasi lembar cetak per operator dan mesin di menu /hasil-produksi&#xa;• Monitoring pencapaian target harian (/target) &amp; efisiensi pabrik di /dashboard-manufaktur" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#a7f3d0;strokeColor=#059669;fontColor=#064e3b;" vertex="1" parent="1"><mxGeometry x="670" y="640" width="480" height="65" as="geometry"/></mxCell><mxCell id="e2_1" value="Plotting Antrean ke Jadwal Shift" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#ea580c;" edge="1" parent="1" source="s2_in" target="s2_sched"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2_2" value="Eksekusi Kerja Mesin Lapangan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#ea580c;" edge="1" parent="1" source="s2_sched" target="s2_exec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2_3" value="Rampung Cetak &amp; Finishing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#16a34a;" edge="1" parent="1" source="s2_exec" target="s2_finish"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2_4" value="Konsolidasi Hasil Kerja" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#059669;" edge="1" parent="1" source="s2_finish" target="s2_dash"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c3_bg" value="3. SIKLUS KEDISIPLINAN SDM &amp; CATAT KESALAHAN&#xa;Tabel: employees, infractions (17 baris) — Native SINTAK" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;strokeWidth=2;align=center;verticalAlign=top;spacingTop=12;fontStyle=1;fontSize=12;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#881337;" vertex="1" parent="1"><mxGeometry x="1240" y="105" width="540" height="740" as="geometry"/></mxCell><mxCell id="s3_emp" value="1. MASTER KARYAWAN AKTIF (/karyawan)&#xa;• Master data pegawai: NIP, nama lengkap, jabatan, divisi kerja, dan status aktif (154 baris)&#xa;• Menjadi referensi validasi nama operator shift JHP dan akun pengguna" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;" vertex="1" parent="1"><mxGeometry x="1270" y="175" width="480" height="65" as="geometry"/></mxCell><mxCell id="s3_inc" value="2. INSIDEN KESALAHAN KERJA LAPANGAN (/records)&#xa;• Terjadi kesalahan teknis: afkir cetak berlebih, salah potong, plat baret, salah bahan&#xa;• Staf/Supervisor melaporkan kronologi kejadian terikat ke nomor order produksi (faktur)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#fecdd3;strokeColor=#e11d48;fontColor=#881337;" vertex="1" parent="1"><mxGeometry x="1270" y="290" width="480" height="65" as="geometry"/></mxCell><mxCell id="s3_low" value="SEVERITY: &#x27;Low&#x27;&#xa;• Kesalahan operasional minor / non-fatal&#xa;• Sanksi teguran &amp; pembinaan kerja shift" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#fef08a;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="1270" y="405" width="230" height="85" as="geometry"/></mxCell><mxCell id="s3_med" value="SEVERITY: &#x27;Medium&#x27;&#xa;• Kerusakan material signifikan (kertas, plat, tinta)&#xa;• Penetapan beban ganti rugi finansial staf" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="1520" y="405" width="230" height="85" as="geometry"/></mxCell><mxCell id="s3_sanction" value="4. PENETAPAN SANKSI &amp; BEBAN BIAYA GANTI RUGI&#xa;• Sistem menghitung beban rupiah perbaikan berdasarkan jenis bahan dan kuantitas rusak&#xa;• Rekam data tersimpan permanen di tabel infractions untuk arsip personalia" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#fce7f3;strokeColor=#db2777;fontColor=#831843;" vertex="1" parent="1"><mxGeometry x="1270" y="520" width="480" height="65" as="geometry"/></mxCell><mxCell id="s3_eval" value="5. EVALUASI KEDISIPLINAN DI DASHBOARD HRD (/dashboard-hrd)&#xa;• Grafik tren insiden kesalahan kerja bulanan (InfractionsTrendChart)&#xa;• Analisis evaluasi sebaran kesalahan per departemen dan performa kerja staf" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#f3e8ff;strokeColor=#7c3aed;fontColor=#581c87;" vertex="1" parent="1"><mxGeometry x="1270" y="640" width="480" height="65" as="geometry"/></mxCell><mxCell id="e3_1" value="Pelaporan Insiden Lapangan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#e11d48;" edge="1" parent="1" source="s3_emp" target="s3_inc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3_2a" value="Klasifikasi Ringan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#ca8a04;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s3_inc" target="s3_low"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3_2b" value="Klasifikasi Material / Fatal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#dc2626;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s3_inc" target="s3_med"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3_3a" value="Pembinaan &amp; Catatan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#ca8a04;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="s3_low" target="s3_sanction"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3_3b" value="Beban Pemotongan Finansial" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#dc2626;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="s3_med" target="s3_sanction"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3_4" value="Kompilasi Tren Bulanan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#7c3aed;" edge="1" parent="1" source="s3_sanction" target="s3_eval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c4_bg" value="4. TATA KELOLA PENGGUNA &amp; BOT TELEGRAM&#xa;Tabel: users, app_roles, telegram_users, activity_logs — Native SINTAK" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=1;strokeWidth=2;align=center;verticalAlign=top;spacingTop=12;fontStyle=1;fontSize=12;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="1840" y="105" width="540" height="740" as="geometry"/></mxCell><mxCell id="s4_user_reg" value="1. REGISTRASI AKUN PENGGUNA (/users)&#xa;• Administrator menginput username, nama lengkap, penautan NIP pegawai (employees)&#xa;• Pemilihan Peran (app_roles: Super Admin, Penjadwalan, Realisasi, Operator, HRD, dll.)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="1870" y="175" width="480" height="65" as="geometry"/></mxCell><mxCell id="s4_user_act" value="2. AKTIVASI AKUN &amp; PEMBATASAN AKSES (RBAC)&#xa;• Status login aktif (is_active = 1), password dienkripsi aman dengan bcrypt&#xa;• Matriks hak akses modul diatur granular di tabel role_permissions (692 konfigurasi izin)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="1870" y="290" width="480" height="65" as="geometry"/></mxCell><mxCell id="s4_bot_reg" value="3. PENDAFTARAN BOT TELEGRAM OPERATOR&#xa;• Operator lapangan mengirim perintah registrasi menghubungkan ID Telegram pribadi&#xa;• Status awal: is_active = 0 (Menunggu persetujuan otorisasi dari Administrator)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#fef08a;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="1870" y="405" width="480" height="65" as="geometry"/></mxCell><mxCell id="s4_bot_appr" value="4. APPROVAL BOT DI /settings/telegram-users&#xa;• Super Admin memverifikasi identitas operator dan menyetujui akses bot (is_active = 1)&#xa;• Operator diizinkan menginput laporan realisasi kerja mandiri via obrolan Telegram" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#a7f3d0;strokeColor=#059669;fontColor=#064e3b;" vertex="1" parent="1"><mxGeometry x="1870" y="520" width="480" height="65" as="geometry"/></mxCell><mxCell id="s4_audit" value="5. AUDIT TRAIL JEJAK AKTIVITAS SISTEM (/activity-log)&#xa;• Setiap aksi CRUD (tambah, edit, hapus, status) terekam otomatis di tabel activity_logs&#xa;• Pemantauan kepatuhan operasional dan jejak digital seluruh pengguna sistem SINTAK" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=9.5;fontStyle=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1870" y="640" width="480" height="65" as="geometry"/></mxCell><mxCell id="e4_1" value="Penetapan Peran &amp; Kredensial" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#2563eb;" edge="1" parent="1" source="s4_user_reg" target="s4_user_act"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4_2" value="Pendaftaran ID Bot Operator" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#ca8a04;" edge="1" parent="1" source="s4_user_act" target="s4_bot_reg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4_3" value="Verifikasi &amp; Otorisasi Admin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#059669;" edge="1" parent="1" source="s4_bot_reg" target="s4_bot_appr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4_4" value="Perekaman Jejak Otomatis" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#475569;" edge="1" parent="1" source="s4_bot_appr" target="s4_audit"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>