        <mxCell id="banner" value="&lt;b&gt;FLOWCHART SISTEM SINTAK (BERDASARKAN STRUKTUR DATA MENU &amp;amp; ALIRAN SISTEM)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size: 11px; font-weight: normal; color: #475569;&#x27;&gt;Pemetaan Aliran Data Hulu ke Hilir: Dari Integrasi Digit ERP, Operasional Percetakan, Kalkulasi &amp;amp; Keuangan, hingga SDM &amp;amp; Tata Kelola&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="40" y="20" width="2140" height="55" as="geometry" />
</mxCell><mxCell id="bg_col1" value="&lt;b&gt;1. INTEGRASI ERP &amp;amp; TRANSAKSI DIGIT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=12;fontSize=11.5;fontStyle=1;strokeWidth=1.5;fillColor=#f0f9ff;strokeColor=#bae6fd;fontColor=#0369a1;" vertex="1" parent="1">
  <mxGeometry x="40" y="95" width="480" height="920" as="geometry" />
</mxCell><mxCell id="b_digit" value="&lt;b&gt;DIGIT ERP (Sistem Eksternal)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;Pusat data master perusahaan:&lt;br/&gt;Order Penjualan (SO), Stok Barang, PR/PO, Pembelian &amp;amp; Keuangan" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="70" y="135" width="420" height="75" as="geometry" />
</mxCell><mxCell id="b_sync" value="&lt;b&gt;Sinkronisasi All Data (/sync)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;Menjalankan scraper untuk menarik batch data dari Digit ke database lokal SINTAK" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9.5;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;align=left;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;" vertex="1" parent="1">
  <mxGeometry x="70" y="260" width="420" height="65" as="geometry" />
</mxCell><mxCell id="b_digit_modules" value="&lt;b&gt;Data Transaksi Digit (Tersimpan di SQLite SINTAK):&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Stok:&lt;/b&gt; Master Barang (&lt;code&gt;/data-digit/stok/master-barang&lt;/code&gt;)&lt;br/&gt;• &lt;b&gt;Pembelian (7 Menu):&lt;/b&gt; PR, SPPH Keluar, SPH Masuk, PO, Penerimaan Barang, Rekap Pembelian, Pelunasan Hutang&lt;br/&gt;• &lt;b&gt;Penjualan (5 Menu):&lt;/b&gt; SPH Keluar, Sales Order (SO), Laporan Penjualan, Pelunasan Piutang, Pengiriman (SJ)&lt;br/&gt;• &lt;b&gt;Akuntansi:&lt;/b&gt; Rek Akuntansi (COA) &amp;amp; Jurnal Umum&lt;br/&gt;• &lt;b&gt;Order Produksi:&lt;/b&gt; BOM &amp;amp; Order SPK (&lt;code&gt;/orders&lt;/code&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9.5;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;align=left;fillColor=#ffffff;strokeColor=#0284c7;" vertex="1" parent="1">
  <mxGeometry x="70" y="375" width="420" height="160" as="geometry" />
</mxCell><mxCell id="b_tracking" value="&lt;b&gt;Tracking Manufaktur (/tracking-manufaktur)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;Melacak status siklus hidup dokumen manufaktur dari hulu ke hilir:&lt;br/&gt;&lt;code&gt;Sales Order &amp;rarr; SPK &amp;rarr; BOM &amp;rarr; PR/PO &amp;rarr; Penerimaan Barang &amp;rarr; BBB &amp;rarr; Kirim (SJ) &amp;rarr; Pelunasan Piutang&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9.5;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;align=left;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=2;" vertex="1" parent="1">
