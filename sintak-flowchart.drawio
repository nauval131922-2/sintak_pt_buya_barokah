</mxCell><mxCell id="b_tracking" value="&lt;b&gt;Tracking Manufaktur (/tracking-manufaktur) [PELACAKAN SIKLUS HIDUP DOKUMEN OPERASIONAL]&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;Pelacakan alur dokumen operasional: Pengguna menginput nomor faktur apa saja (BOM, Order Produksi, PO, Rekap PB, atau Sales Order) &amp;rarr; Sistem menelusuri seluruh siklus hidup dokumen secara otomatis:&lt;br/&gt;&lt;code&gt;1. Pembelian (PR &amp;rarr; SPPH &amp;rarr; SPH In &amp;rarr; PO &amp;rarr; Penerimaan &amp;rarr; Rekap PB &amp;rarr; Hutang) &amp;harr; 2. Penjualan (SPH Out &amp;rarr; Sales Order &amp;rarr; Laporan Penjualan &amp;rarr; Pengiriman SJ &amp;rarr; Piutang) &amp;harr; 3. Produksi (BOM &amp;rarr; Order Produksi &amp;rarr; BBB &amp;rarr; Barang Jadi)&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=8;verticalAlign=middle;spacing=4;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;align=left;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=2;fontSize=8.5;" vertex="1" parent="1">
  <mxGeometry x="65" y="865" width="1595" height="65" as="geometry" />
</mxCell><mxCell id="e_ph_track" value="Alur Pembelian" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#a855f7;strokeWidth=2;endArrow=classic;endFill=1;fontSize=7.5;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.12;entryY=0;entryDx=0;entryDy=0;fontColor=#6b21a8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_pelunasan_hutang" target="b_tracking">
  <mxGeometry relative="1" as="geometry">
  </mxGeometry>
</mxCell><mxCell id="e_piut_track" value="Alur Penjualan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#a855f7;strokeWidth=2;endArrow=classic;endFill=1;fontSize=7.5;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.42;entryY=0;entryDx=0;entryDy=0;fontColor=#6b21a8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t_pelunasan_piutang" target="b_tracking">
