  <mxGeometry x="585" y="850" width="405" height="65" as="geometry" />
</mxCell><mxCell id="b_gsheet_laporan" value="&lt;b&gt;Google Spreadsheet API&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Live Tab: DATABASE_REPORT)&lt;/i&gt;&lt;br/&gt;&lt;hr/&gt;Fitur Reset &amp;amp; Sync Fresh di &lt;code&gt;/settings/konversi-data/laporan-pekerjaan&lt;/code&gt; mendownload CSV live dari Google Spreadsheet pusat" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;spacing=5;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;align=left;fillColor=#f0fdf4;strokeColor=#16a34a;dashed=1;fontSize=8;align=left;" vertex="1" parent="1">
