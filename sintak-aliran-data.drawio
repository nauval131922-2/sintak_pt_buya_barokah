        <mxCell id="banner" value="&lt;b&gt;ALUR KERJA SETIAP ROLE PENGGUNA (FLOW OF ROLES SINTAK - PT BUYA BAROKAH)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size: 11px; font-weight: normal; color: #475569;&#x27;&gt;Pemetaan Lengkap Berdasarkan database_dev.sqlite &amp;amp; Kode Sumber: Sumber Data, Tahapan Kerja (Step-by-Step), Menu yang Diakses, dan Data Akhir yang Dihasilkan&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1">
