        <mxCell id="banner" value="&lt;b&gt;ALIRAN DATA END-TO-END SINTAK (PT BUYA BAROKAH)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size: 11px; font-weight: normal; color: #475569;&#x27;&gt;Visualisasi Aliran Data Nyata Berdasarkan Source Code SINTAK: Dari Tarik Data Digit -&gt; SOPd -&gt; JHP (Web &amp;amp; Bot Telegram) -&gt; QC &amp;amp; Hasil -&gt; Akuntansi &amp;amp; 4 Dashboard&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1">
