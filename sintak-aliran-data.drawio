lLoop=1;jettySize=auto;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=classic;fontSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="0" height="0" as="geometry" /></mxCell><mxCell id="e20" value="Data Arus Kas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=classic;fontSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="0" height="0" as="geometry" /></mxCell><mxCell id="e21" value="Data Utilisasi Mesin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=classic;fontSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="0" height="0" as="geometry" /></mxCell><mxCell id="e22" value="KPI Order Aktif" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=classic;fontSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="0" height="0" as="geometry" /></mxCell>
