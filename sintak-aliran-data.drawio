</mxCell><mxCell id="r_0" value="&lt;b&gt;Admin Penjadwalan&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#991b1b;fontSize=10.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;" vertex="1" parent="1">
  <mxGeometry x="60" y="135" width="220" height="92" as="geometry" />
</mxCell><mxCell id="s_0" value="• &lt;b&gt;Tabel orders:&lt;/b&gt; Order produksi dari Digit via /sync&lt;br/&gt;• &lt;b&gt;Tabel sopd:&lt;/b&gt; Upload Excel di /settings/konversi-data&lt;br/&gt;• &lt;b&gt;Tabel employees:&lt;/b&gt; Master nama operator per bagian&lt;br/&gt;• &lt;b&gt;Tabel master_pekerjaan:&lt;/b&gt; Kategori jenis pekerjaan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9.5;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#ef4444;align=left;" vertex="1" parent="1">
  <mxGeometry x="330" y="135" width="330" height="92" as="geometry" />
</mxCell><mxCell id="st1_0" value="&lt;b&gt;Buka Menu SOPd (/data/excel-sopd) &amp;rarr;&lt;/b&gt;&lt;br/&gt;• Cek antrean pesanan masuk (No SOPd, Oplah, Deadline)&lt;br/&gt;• Lakukan inline edit 2x klik jika ada koreksi estimasi harga/deadline pesanan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9.5;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#ef4444;align=left;" vertex="1" parent="1">
