</mxCell><mxCell id="st1_1" value="&lt;b&gt;Buka JHP (/jurnal-harian-produksi) Tab Realisasi &amp;rarr;&lt;/b&gt;&lt;br/&gt;• Buka baris jadwal kerja shift hari ini&lt;br/&gt;• Input &lt;b&gt;Jam Mulai &amp;amp; Jam Selesai&lt;/b&gt; pengerjaan (misal 07:00-15:00)&lt;br/&gt;• Input jumlah lembar &lt;b&gt;Realisasi&lt;/b&gt; yang berhasil diselesaikan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9.5;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#ef4444;align=left;" vertex="1" parent="1">
