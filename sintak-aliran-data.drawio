  <diagram id="diag-peta-menu" name="2. Peta Menu &amp; Fungsi SINTAK">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2_banner" value="&lt;b&gt;PETA STRUKTUR MENU, ASAL DATA &amp;amp; FUNGSI NYATA SELURUH SINTAK&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size: 11px; font-weight: normal; color: #475569;&#x27;&gt;Arsitektur Lengkap Sesuai Sidebar &amp;amp; Kode Sumber (Tanpa Panah Hubungan Buatan Antar Modul Independen)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="40" y="20" width="1440" height="50" as="geometry" />
</mxCell><mxCell id="p2_g_dash" value="&lt;b&gt;1. KELOMPOK DASHBOARD (4 DASHBOARD EKSEKUTIF)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-weight: normal; font-size: 10px; color: #047857;&#x27;&gt;Masing-masing dashboard membaca query database secara mandiri untuk menyajikan grafik dan kartu statistik:&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontColor=#047857;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="40" y="85" width="1440" height="145" as="geometry" />
</mxCell><mxCell id="p2_d_umum" value="&lt;b&gt;Dashboard Umum&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/dashboard&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;UsersStatCard:&lt;/b&gt; Statistik jumlah user sistem &amp;amp; role&lt;br/&gt;• &lt;b&gt;Akses Cepat:&lt;/b&gt; Pintasan ke menu administrasi&lt;br/&gt;• &lt;b&gt;AktivitasTerbaruCard:&lt;/b&gt; Log 8 aktivitas sistem terbaru dari tabel &lt;code&gt;activity_logs&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#059669;align=left;" vertex="1" parent="1">
  <mxGeometry x="60" y="125" width="330" height="90" as="geometry" />
</mxCell><mxCell id="p2_d_manufaktur" value="&lt;b&gt;Dashboard Produksi&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/dashboard-manufaktur&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;OrdersStatCard:&lt;/b&gt; Statistik total order produksi dari Digit&lt;br/&gt;• &lt;b&gt;JurnalStatCard:&lt;/b&gt; Target vs Realisasi lembar cetak JHP&lt;br/&gt;• &lt;b&gt;ProduksiTrendChart:&lt;/b&gt; Grafik tren BBB &amp;amp; Hasil Produksi&lt;br/&gt;• &lt;b&gt;JurnalTerbaruCard:&lt;/b&gt; Daftar jurnal produksi terbaru" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#059669;align=left;" vertex="1" parent="1">
  <mxGeometry x="410" y="125" width="340" height="90" as="geometry" />
</mxCell><mxCell id="p2_d_hrd" value="&lt;b&gt;Dashboard HRD&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/dashboard-hrd&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;KaryawanStatCard:&lt;/b&gt; Statistik total karyawan aktif per bagian&lt;br/&gt;• &lt;b&gt;InfractionsTrendChart:&lt;/b&gt; Grafik tren kesalahan karyawan per bulan dari modul &lt;code&gt;/records&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#059669;align=left;" vertex="1" parent="1">
  <mxGeometry x="770" y="125" width="330" height="90" as="geometry" />
</mxCell><mxCell id="p2_d_akt" value="&lt;b&gt;Dashboard Akuntansi&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/dashboard-akunting&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;AkuntingTrendChart:&lt;/b&gt; Grafik tren Jurnal Umum (Debet vs Kredit)&lt;br/&gt;• &lt;b&gt;WarningBarangJadiCard:&lt;/b&gt; Peringatan barang jadi&lt;br/&gt;• &lt;b&gt;JurnalAkuntansiTerbaru:&lt;/b&gt; Rincian transaksi jurnal terbaru" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#059669;align=left;" vertex="1" parent="1">
  <mxGeometry x="1120" y="125" width="340" height="90" as="geometry" />
</mxCell><mxCell id="p2_g_digit" value="&lt;b&gt;2. KELOMPOK DATA DIGIT (TARIKAN DATA DARI ERP DIGIT VIA /sync)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-weight: normal; font-size: 10px; color: #0369a1;&#x27;&gt;Di SINTAK, seluruh menu ini murni menampilkan data hasil tarikan (scraping) dari ERP Digit, bukan tempat menginput transaksi baru:&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#bae6fd;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontColor=#0369a1;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="40" y="245" width="1440" height="155" as="geometry" />
</mxCell><mxCell id="p2_digit_sync" value="&lt;b&gt;Sinkronisasi All Data (/sync)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;Modul pusat untuk menarik batch data dari ERP Digit per periode tanggal/bulan ke database lokal SQLite SINTAK." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;align=left;" vertex="1" parent="1">
  <mxGeometry x="60" y="290" width="255" height="95" as="geometry" />
</mxCell><mxCell id="p2_digit_stok" value="&lt;b&gt;Stok: Master Barang&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/data-digit/stok/master-barang&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Menampilkan data master barang, barcode, saldo awal, masuk, keluar, saldo akhir, harga beli &amp;amp; jual dari Digit." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#0284c7;align=left;" vertex="1" parent="1">
  <mxGeometry x="330" y="290" width="265" height="95" as="geometry" />
</mxCell><mxCell id="p2_digit_beli" value="&lt;b&gt;Pembelian (7 Menu Digit)&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/pr, /spph-out, /sph-in, /purchase-orders, /penerimaan-pembelian, /rekap-pembelian-barang, /pelunasan-hutang&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Menampilkan data pengadaan bahan baku, PO supplier, bukti penerimaan barang, faktur pembelian, dan pelunasan hutang dari Digit." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#0284c7;align=left;" vertex="1" parent="1">
  <mxGeometry x="610" y="290" width="280" height="95" as="geometry" />
</mxCell><mxCell id="p2_digit_jual" value="&lt;b&gt;Penjualan (5 Menu Digit)&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/sph-out, /sales-orders, /sales, /pengiriman, /pelunasan-piutang&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Menampilkan data SPH penawaran, pesanan Sales Order barang, faktur penjualan, Surat Jalan pengiriman, dan pelunasan piutang customer dari Digit." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#0284c7;align=left;" vertex="1" parent="1">
  <mxGeometry x="905" y="290" width="280" height="95" as="geometry" />
</mxCell><mxCell id="p2_digit_akt" value="&lt;b&gt;Akuntansi (2 Menu Digit)&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/akuntansi/data/rek-akuntansi&lt;/code&gt;&lt;br/&gt;&lt;code&gt;/akuntansi/laporan/jurnal-umum&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Menampilkan master bagan akun (COA) dan transaksi Jurnal Umum (Debet, Kredit, Laba Rugi). Terdapat tombol &#x27;Analisis Jurnal&#x27; cek neraca." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#0284c7;align=left;" vertex="1" parent="1">
  <mxGeometry x="1200" y="290" width="260" height="95" as="geometry" />
</mxCell><mxCell id="p2_g_prod" value="&lt;b&gt;3. KELOMPOK OPERASIONAL PRODUKSI SINTAK (JHP, TARGET, ANALISA, HASIL &amp;amp; LAPORAN PEKERJAAN)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fecaca;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontColor=#b91c1c;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="40" y="415" width="1440" height="160" as="geometry" />
</mxCell><mxCell id="p2_prod_sopd" value="&lt;b&gt;SOPd (/data/excel-sopd)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;Daftar antrean order gabungan dari Digit (orders) &amp;amp; upload Excel SOPd. Inline edit cell 2x klik untuk harga, deadline, keterangan." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#dc2626;align=left;" vertex="1" parent="1">
  <mxGeometry x="60" y="455" width="265" height="105" as="geometry" />
</mxCell><mxCell id="p2_prod_jhp" value="&lt;b&gt;Jurnal Harian Produksi (/jurnal-harian-produksi)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• Input Target: Bagian, Shift, Operator, No SOPd, Target (fitur Copy Jadwal)&lt;br/&gt;• Input Realisasi: Jam kerja, Lembar Berhasil, Rijek&lt;br/&gt;• Jalur Alternatif: Input Realisasi via Bot Telegram (/api/telegram/realisasi)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=2;align=left;" vertex="1" parent="1">
  <mxGeometry x="340" y="455" width="335" height="105" as="geometry" />
</mxCell><mxCell id="p2_prod_sub" value="&lt;b&gt;Target &amp;amp; Analisa&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/target&lt;/code&gt; &amp;amp; &lt;code&gt;/analisa&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Target Harian:&lt;/b&gt; Rekap pemenuhan target shift hari ini per bagian&lt;br/&gt;• &lt;b&gt;Analisa:&lt;/b&gt; Cari per No Order untuk melihat riwayat seluruh pengerjaan JHP &amp;amp; kendala" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#dc2626;align=left;" vertex="1" parent="1">
  <mxGeometry x="690" y="455" width="255" height="105" as="geometry" />
</mxCell><mxCell id="p2_prod_hasil" value="&lt;b&gt;Hasil Produksi (/hasil-produksi)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Tab Jurnal:&lt;/b&gt; Rekap total target, realisasi &amp;amp; rijek per jenis pekerjaan dari JHP&lt;br/&gt;• &lt;b&gt;Tab Barang Jadi:&lt;/b&gt; Data barang jadi dari Digit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#dc2626;align=left;" vertex="1" parent="1">
  <mxGeometry x="960" y="455" width="250" height="105" as="geometry" />
</mxCell><mxCell id="p2_prod_lap" value="&lt;b&gt;Laporan Pekerjaan (/laporan-pekerjaan)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;Monitoring &amp;amp; pelaporan tugas kerja harian per karyawan dan bagian (Setting, QC, Cetak, Finishing, Gudang, Teknisi, Mesin)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#dc2626;align=left;" vertex="1" parent="1">
  <mxGeometry x="1225" y="455" width="235" height="105" as="geometry" />
</mxCell><mxCell id="p2_g_support" value="&lt;b&gt;4. KELOMPOK KALKULASI, HRD &amp;amp; PENGATURAN SISTEM (MODUL-MODUL MANDIRI)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf4ff;strokeColor=#f0abfc;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontColor=#86198f;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="40" y="590" width="1440" height="160" as="geometry" />
</mxCell><mxCell id="p2_calc" value="&lt;b&gt;Kalkulasi: Pricelist &amp;amp; HPP&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/pricelist&lt;/code&gt; &amp;amp; &lt;code&gt;/hpp-kalkulasi&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Pricelist:&lt;/b&gt; Simulator mandiri 20+ produk cetak (Buku, Dus, Stopmap, Brosur, dll.)&lt;br/&gt;• &lt;b&gt;HPP Kalkulasi:&lt;/b&gt; Input nilai HPP per nama order&lt;br/&gt;• &lt;b&gt;Rekap SO:&lt;/b&gt; Rekap baris Sales Order dari Digit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#a855f7;align=left;" vertex="1" parent="1">
  <mxGeometry x="60" y="630" width="335" height="105" as="geometry" />
</mxCell><mxCell id="p2_hrd" value="&lt;b&gt;HRD: Karyawan &amp;amp; Catat Kesalahan&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/employees&lt;/code&gt; &amp;amp; &lt;code&gt;/records&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Karyawan:&lt;/b&gt; Master NIP, Nama, Jabatan, Bagian, Status&lt;br/&gt;• &lt;b&gt;Catat Kesalahan:&lt;/b&gt; Pencatatan insiden kelalaian kerja &amp;amp; rincian beban kerugian finansial (mengalir ke Dashboard HRD)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#e11d48;align=left;" vertex="1" parent="1">
  <mxGeometry x="410" y="630" width="330" height="105" as="geometry" />
</mxCell><mxCell id="p2_tracking" value="&lt;b&gt;Umum: Tracking Manufaktur &amp;amp; Log&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/tracking-manufaktur&lt;/code&gt; &amp;amp; &lt;code&gt;/log-aktivitas&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Tracking:&lt;/b&gt; Melacak aliran dokumen manufaktur dari Digit (SO -&gt; BOM -&gt; PO -&gt; BBB -&gt; Kirim -&gt; Piutang)&lt;br/&gt;• &lt;b&gt;Log Aktivitas:&lt;/b&gt; Audit trail riwayat aksi user di sistem" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#7c3aed;align=left;" vertex="1" parent="1">
  <mxGeometry x="755" y="630" width="345" height="105" as="geometry" />
</mxCell><mxCell id="p2_settings" value="&lt;b&gt;Pengaturan: User, Roles &amp;amp; Konversi&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/users&lt;/code&gt;, &lt;code&gt;/roles&lt;/code&gt;, &lt;code&gt;/settings/...&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Kelola User &amp;amp; Hak Akses:&lt;/b&gt; Manajemen akun login &amp;amp; permission RBAC&lt;br/&gt;• &lt;b&gt;Telegram Users:&lt;/b&gt; Approval akun operator untuk Bot Telegram&lt;br/&gt;• &lt;b&gt;Konversi Data:&lt;/b&gt; Migrasi file Excel HPP, JHP, dan Laporan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#475569;align=left;" vertex="1" parent="1">
