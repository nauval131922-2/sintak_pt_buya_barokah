</mxCell><mxCell id="n_price" value="&lt;b&gt;Kalkulasi Harga &amp;amp; HPP&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/pricelist &amp;amp; /hpp-kalkulasi&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Pricelist:&lt;/b&gt; Simulator mandiri 20+ produk cetak&lt;br/&gt;• &lt;b&gt;HPP Kalkulasi:&lt;/b&gt; Nilai HPP order untuk acuan di /records" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#0284c7;align=left;" vertex="1" parent="1">
