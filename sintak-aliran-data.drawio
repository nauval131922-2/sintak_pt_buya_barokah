</mxCell><mxCell id="st2_0" value="&lt;b&gt;Buka JHP (/jurnal-harian-produksi) Tab Penjadwalan &amp;rarr;&lt;/b&gt;&lt;br/&gt;• Pilih Bagian, Shift (1/2/3), Operator, No SOPd &amp;amp; Target&lt;br/&gt;• &lt;b&gt;Fitur &#x27;Copy Jadwal&#x27;:&lt;/b&gt; Salin susunan target shift dari hari kemarin agar tidak perlu input ulang dari nol" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9.5;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#ef4444;align=left;" vertex="1" parent="1">
