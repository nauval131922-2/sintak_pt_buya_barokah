  <mxGeometry x="330" y="90" width="330" height="32" as="geometry" />
</mxCell><mxCell id="h_col3" value="&lt;b&gt;3. STEP 1: TINDAKAN OPERASIONAL DI MENU UTAMA&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=10.5;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
