</mxCell><mxCell id="h_col1" value="&lt;b&gt;1. NAMA ROLE (DATABASE DEV)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=10.5;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
  <mxGeometry x="60" y="90" width="220" height="32" as="geometry" />
