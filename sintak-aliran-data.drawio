  <mxGeometry x="60" y="245" width="220" height="92" as="geometry" />
</mxCell><mxCell id="s_1" value="• &lt;b&gt;Tabel jurnal_harian_produksi:&lt;/b&gt; Target jadwal yang telah dibuat oleh Admin Penjadwalan&lt;br/&gt;• &lt;b&gt;Laporan Fisik Lapangan:&lt;/b&gt; Lembar fisik pengerjaan harian dari operator mesin/divisi" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9.5;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#ef4444;align=left;" vertex="1" parent="1">
