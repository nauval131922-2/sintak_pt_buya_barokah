        <mxCell id="zone1" value="1. SUMBER DATA &amp; INPUT" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;rounded=1;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="260" height="580" as="geometry" /></mxCell><mxCell id="zone2" value="2. DOKUMEN ORDER (SOPd)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#fffbeb;strokeColor=#d97706;rounded=1;" vertex="1" parent="1"><mxGeometry x="320" y="40" width="260" height="580" as="geometry" /></mxCell><mxCell id="zone3" value="3. LANTAI PABRIK (JHP)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#fef2f2;strokeColor=#dc2626;rounded=1;" vertex="1" parent="1"><mxGeometry x="610" y="40" width="290" height="580" as="geometry" /></mxCell><mxCell id="zone4" value="4. ANALISA, HASIL &amp; QC" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#fdf2f8;strokeColor=#db2777;rounded=1;" vertex="1" parent="1"><mxGeometry x="930" y="40" width="310" height="580" as="geometry" /></mxCell><mxCell id="zone5" value="5. LOGISTIK &amp; TRACKING" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;rounded=1;" vertex="1" parent="1"><mxGeometry x="1270" y="40" width="270" height="580" as="geometry" /></mxCell><mxCell id="zone6" value="6. KEUANGAN, AKUNTANSI &amp; 4 DASHBOARD EKSEKUTIF" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#ecfdf5;strokeColor=#059669;rounded=1;" vertex="1" parent="1"><mxGeometry x="30" y="650" width="1510" height="260" as="geometry" /></mxCell><mxCell id="node_erp" value="&lt;b&gt;SISTEM ERP DIGIT&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Sistem Eksternal)&lt;/i&gt;&lt;br/&gt;&lt;hr/&gt;Menyimpan Data Order SO, Stok Barang,&lt;br/&gt;Pembelian, Hutang/Piutang &amp; Jurnal" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="90" width="210" height="95" as="geometry" /></mxCell><mxCell id="node_sync" value="&lt;b&gt;Menu: Sinkronisasi All Data&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/sync&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• SINTAK hanya &lt;b&gt;tarik data&lt;/b&gt; dari Digit&lt;br/&gt;• Pilih periode -&gt; Klik &#x27;Mulai Sync&#x27;&lt;br/&gt;• Data masuk ke database SINTAK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="55" y="230" width="210" height="100" as="geometry" /></mxCell><mxCell id="node_price" value="&lt;b&gt;Kalkulasi Harga &amp; HPP&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/pricelist &amp; /hpp-kalkulasi&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• Estimator hitung spek cetak &amp; oplah&lt;br/&gt;• Hitung kebutuhan plano kertas &amp; plat&lt;br/&gt;• Menghasilkan acuan harga cetak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="55" y="380" width="210" height="100" as="geometry" /></mxCell><mxCell id="node_sopd" value="&lt;b&gt;Menu: SOPd&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/jurnal-harian-produksi/data/excel-sopd&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Data Masuk:&lt;/b&gt; Tarikan Order dari Digit / Excel&lt;br/&gt;• Cek No SOPd, oplah, deadline &amp; harga&lt;br/&gt;• Edit cepat cell 2x klik (harga/keterangan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="345" y="230" width="210" height="100" as="geometry" /></mxCell><mxCell id="node_dec_pending" value="Ada Kendala&lt;br/&gt;Produksi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="370" width="140" height="80" as="geometry" /></mxCell><mxCell id="node_pending" value="&lt;b&gt;Tandai &#x27;Pending Produksi&#x27;&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• Centang checkbox Pending&lt;br/&gt;• Ketik alasan (kertas kosong/tunggu plat)&lt;br/&gt;• Otomatis terbaca di Tracking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="345" y="480" width="210" height="80" as="geometry" /></mxCell><mxCell id="node_master" value="&lt;b&gt;Master Pendukung:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Master Pekerjaan:&lt;/b&gt; Standar mesin/jam&lt;br/&gt;• &lt;b&gt;Master Karyawan:&lt;/b&gt; Nama operator shift" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;fontSize=10;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="230" height="65" as="geometry" /></mxCell><mxCell id="node_jhp" value="&lt;b&gt;Menu: Jurnal Harian Produksi (JHP)&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/jurnal-harian-produksi&lt;/code&gt; [INTI PABRIK]&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;1. Penjadwalan (Target):&lt;/b&gt;&lt;br/&gt;   • Klik &#x27;Tambah&#x27; atau &#x27;Copy Jadwal&#x27;&lt;br/&gt;   • Pilih Mesin, No SOPd, Operator, &amp; Target&lt;br/&gt;&lt;b&gt;2. Realisasi Kerja:&lt;/b&gt;&lt;br/&gt;   • Operator input Jam Mulai/Selesai&lt;br/&gt;   • Operator input Lembar Berhasil&lt;br/&gt;&lt;b&gt;3. Catat Rijek/Waste:&lt;/b&gt;&lt;br/&gt;   • Input lembar rusak afdruk setup &amp; jalan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="635" y="200" width="240" height="175" as="geometry" /></mxCell><mxCell id="node_target" value="&lt;b&gt;Menu: Target Harian&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/jurnal-harian-produksi/target&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Rekap pemenuhan target shift hari ini" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#db2777;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="960" y="90" width="250" height="65" as="geometry" /></mxCell><mxCell id="node_analisa" value="&lt;b&gt;Menu: Analisa Produksi&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/jurnal-harian-produksi/analisa&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Hitung efisiensi mesin vs target (%) &amp;amp; tren waste" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#db2777;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="960" y="180" width="250" height="65" as="geometry" /></mxCell><mxCell id="node_hasil" value="&lt;b&gt;Menu: Hasil Produksi&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/hasil-produksi&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Rekap barang cetak selesai &amp;amp; verifikasi kuantitas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#db2777;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="960" y="270" width="250" height="65" as="geometry" /></mxCell><mxCell id="node_records" value="&lt;b&gt;Menu: Catat Kesalahan (QC &amp;amp; HRD)&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/records&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• Catat jika ada salah potong/plat/rusak parah&lt;br/&gt;• Input nama operator, taksiran rugi (Rp) &amp;amp; SP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e11d48;strokeWidth=2;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="960" y="360" width="250" height="75" as="geometry" /></mxCell><mxCell id="node_telegram" value="&lt;b&gt;Alert Bot Telegram&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;Otomatis broadcast notifikasi insiden&lt;br/&gt;kesalahan kerja ke HP pimpinan/manajer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="960" y="465" width="250" height="65" as="geometry" /></mxCell><mxCell id="node_gudang" value="&lt;b&gt;Gudang Barang Jadi&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/barang-jadi&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• Tahap finishing (potong/lipat/laminasi/jilid)&lt;br/&gt;• Serah terima fisik &amp;amp; status &#x27;Selesai&#x27;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1295" y="120" width="220" height="80" as="geometry" /></mxCell><mxCell id="node_track" value="&lt;b&gt;Menu: Tracking Manufaktur&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/tracking-manufaktur&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Gabungkan data SOPd + JHP + Hasil:&lt;br/&gt;Visual posisi order (Pra-Cetak -&gt; Cetak -&gt; Finishing -&gt; Siap Kirim)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1295" y="250" width="220" height="95" as="geometry" /></mxCell><mxCell id="node_ship" value="&lt;b&gt;Menu: Pengiriman&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/pengiriman&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• Terbitkan Surat Jalan (SJ) resmi&lt;br/&gt;• Ekspedisi kirim barang ke customer&lt;br/&gt;• Customer tanda tangan tanda terima fisik" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1295" y="410" width="220" height="85" as="geometry" /></mxCell><mxCell id="node_sales" value="&lt;b&gt;Penjualan &amp;amp; Pelunasan Piutang&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/sales &amp;amp; /pelunasan-piutang&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Faktur Penjualan diterbitkan -&gt; Catat Piutang -&gt; Status Lunas saat customer bayar transfer/kas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="710" width="310" height="80" as="geometry" /></mxCell><mxCell id="node_jurnal" value="&lt;b&gt;Menu: Jurnal Umum&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/akuntansi/laporan/jurnal-umum&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• Tarikan jurnal dari Digit &amp;amp; pencatatan transaksi&lt;br/&gt;• Tombol &#x27;Analisis Jurnal&#x27; cek balancing Debet = Kredit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="420" y="710" width="320" height="80" as="geometry" /></mxCell><mxCell id="node_dash_umum" value="&lt;b&gt;Dashboard Umum&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/dashboard&lt;/code&gt;&lt;br/&gt;Ringkasan order aktif &amp;amp; omzet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="790" y="700" width="160" height="60" as="geometry" /></mxCell><mxCell id="node_dash_manufaktur" value="&lt;b&gt;Dashboard Manufaktur&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/dashboard-manufaktur&lt;/code&gt;&lt;br/&gt;Tren lembar cetak &amp;amp; efisiensi mesin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="970" y="700" width="175" height="60" as="geometry" /></mxCell><mxCell id="node_dash_hrd" value="&lt;b&gt;Dashboard HRD&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/dashboard-hrd&lt;/code&gt;&lt;br/&gt;Tren kesalahan operator &amp;amp; KPI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1165" y="700" width="165" height="60" as="geometry" /></mxCell><mxCell id="node_dash_akt" value="&lt;b&gt;Dashboard Akuntansi&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/dashboard-akunting&lt;/code&gt;&lt;br/&gt;Tren debit/kredit &amp;amp; arus kas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1350" y="700" width="165" height="60" as="geometry" /></mxCell><mxCell id="e1" value="Tarik data berkala" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=classic;fontSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="0" height="0" as="geometry" /></mxCell><mxCell id="e2" value="Data Order masuk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=classic;fontSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="0" height="0" as="geometry" /></mxCell><mxCell id="e3" value="Acuan HPP &amp; Spek" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=classic;fontSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="0" height="0" as="geometry" /></mxCell><mxCell id="e4" value="Cek Kesiapan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0369a1;strokeWidth=2;endArrow=classic;fontSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="0" height="0" as="geometry" /></mxCell><mxCell id="e5" value="YA (Terkendala)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html