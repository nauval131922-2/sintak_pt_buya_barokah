  <diagram id="sintak-clean-flow" name="Aliran Data SINTAK">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner" value="&lt;b&gt;ALIRAN DATA END-TO-END SINTAK (PT BUYA BAROKAH)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size: 11px; font-weight: normal; color: #475569;&#x27;&gt;Aliran Data Nyata Berdasarkan Source Code SINTAK (Tanpa Asumsi / Tanpa Panah Rekayasa)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="40" y="20" width="1260" height="50" as="geometry" />
</mxCell><mxCell id="bg_main" value="&lt;b&gt;ALUR UTAMA: DARI TARIK ORDER DIGIT HINGGA HASIL PRODUKSI&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#bbf7d0;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontColor=#166534;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="40" y="85" width="1260" height="475" as="geometry" />
</mxCell><mxCell id="n_erp" value="&lt;b&gt;ERP DIGIT&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Sistem Eksternal)&lt;/i&gt;&lt;br/&gt;&lt;hr/&gt;Menyimpan data Order Produksi (orders)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="60" y="130" width="200" height="85" as="geometry" />
</mxCell><mxCell id="n_sync" value="&lt;b&gt;Menu: Sinkronisasi (/sync)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;SINTAK menarik data Order Produksi&lt;br/&gt;dari ERP Digit ke database lokal" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;align=left;" vertex="1" parent="1">
  <mxGeometry x="320" y="130" width="230" height="85" as="geometry" />
</mxCell><mxCell id="n_excel_sopd" value="&lt;b&gt;Upload Excel SOPd&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Konversi Data)&lt;/i&gt;&lt;br/&gt;&lt;hr/&gt;Import file Excel data SOPd" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#d97706;dashed=1;align=left;" vertex="1" parent="1">
  <mxGeometry x="320" y="230" width="230" height="65" as="geometry" />
</mxCell><mxCell id="n_sopd" value="&lt;b&gt;Menu: SOPd (/data/excel-sopd)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• Memuat gabungan Order Digit &amp;amp; Excel SOPd&lt;br/&gt;• Daftar antrean order (No SOPd, nama order, oplah, deadline)&lt;br/&gt;• Edit cepat cell 2x klik (harga/keterangan)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;align=left;" vertex="1" parent="1">
  <mxGeometry x="610" y="130" width="310" height="95" as="geometry" />
</mxCell><mxCell id="n_jhp" value="&lt;b&gt;Menu: Jurnal Harian Produksi (JHP)&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/jurnal-harian-produksi&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;1. Penjadwalan (Target):&lt;/b&gt; Pilih Bagian, Shift, Operator, No SOPd, Target&lt;br/&gt;   (Tersedia tombol &#x27;Copy Jadwal&#x27; untuk salin susunan dari hari sebelumnya)&lt;br/&gt;• &lt;b&gt;2. Input Realisasi:&lt;/b&gt; Jam Mulai/Selesai &amp;amp; Lembar Berhasil&lt;br/&gt;• &lt;b&gt;3. Catat Rijek:&lt;/b&gt; Operator input lembar afdruk rusak" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=2;align=left;" vertex="1" parent="1">
  <mxGeometry x="590" y="280" width="350" height="130" as="geometry" />
</mxCell><mxCell id="n_master" value="&lt;b&gt;Master Pendukung:&lt;/b&gt;&lt;br/&gt;• Master Pekerjaan Jurnal Produksi (kategori &amp;amp; jenis pekerjaan)&lt;br/&gt;• Master Karyawan (nama operator per bagian)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#b91c1c;align=left;dashed=1;" vertex="1" parent="1">
  <mxGeometry x="230" y="325" width="270" height="70" as="geometry" />
</mxCell><mxCell id="n_telegram" value="&lt;b&gt;Input Realisasi via Bot Telegram&lt;/b&gt;&lt;br/&gt;&lt;code&gt;telegram-bot (/api/telegram/realisasi)&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Operator yang diapprove dapat langsung input Realisasi JHP via chat bot" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=1.5;align=left;" vertex="1" parent="1">
  <mxGeometry x="230" y="420" width="270" height="70" as="geometry" />
</mxCell><mxCell id="n_target" value="&lt;b&gt;Menu: Target Harian (/target)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;Rekap pemenuhan target shift hari ini per bagian dan operator" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#db2777;align=left;" vertex="1" parent="1">
  <mxGeometry x="1000" y="275" width="260" height="60" as="geometry" />
</mxCell><mxCell id="n_analisa" value="&lt;b&gt;Menu: Analisa Produksi (/analisa)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;Cari per No Order: menampilkan seluruh entri pengerjaan di JHP, durasi &amp;amp; kendala" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#db2777;align=left;" vertex="1" parent="1">
  <mxGeometry x="1000" y="350" width="260" height="60" as="geometry" />
</mxCell><mxCell id="n_hasil" value="&lt;b&gt;Menu: Hasil Produksi (/hasil-produksi)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• Tab Jurnal: Total target, realisasi &amp;amp; rijek per jenis pekerjaan&lt;br/&gt;• Tab Barang Jadi: Data barang jadi dari Digit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=2;align=left;" vertex="1" parent="1">
  <mxGeometry x="1000" y="430" width="260" height="75" as="geometry" />
