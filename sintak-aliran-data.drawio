<mxfile host="Electron" modified="2026-10-04T00:00:00.000Z" agent="Mozilla/5.0" version="21.6.8" type="device">
  <diagram id="diag-alur-jhp" name="1. Alur Operasional JHP">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1_banner" value="&lt;b&gt;ALUR OPERASIONAL NYATA JURNAL HARIAN PRODUKSI (JHP) - SINTAK&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size: 11px; font-weight: normal; color: #475569;&#x27;&gt;Aliran Data dari Tarik Order Digit / Excel -&gt; Masuk SOPd -&gt; Diambil ke JHP (Web &amp;amp; Bot Telegram) -&gt; Target Harian, Analisa &amp;amp; Hasil Produksi&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="40" y="20" width="1260" height="50" as="geometry" />
</mxCell><mxCell id="p1_bg_step1" value="&lt;b&gt;1. SUMBER DATA ORDER PRODUKSI (DIGIT &amp;amp; EXCEL)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#bae6fd;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontColor=#0369a1;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="40" y="85" width="1260" height="220" as="geometry" />
</mxCell><mxCell id="p1_erp" value="&lt;b&gt;ERP DIGIT&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Sistem Eksternal)&lt;/i&gt;&lt;br/&gt;&lt;hr/&gt;Menyimpan data Order Produksi (orders)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="60" y="115" width="190" height="85" as="geometry" />
</mxCell><mxCell id="p1_sync" value="&lt;b&gt;Menu: Sinkronisasi (/sync)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• SINTAK menarik data Order Produksi dari ERP Digit&lt;br/&gt;• Tersimpan ke database tabel &lt;code&gt;orders&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;align=left;" vertex="1" parent="1">
  <mxGeometry x="300" y="115" width="260" height="85" as="geometry" />
</mxCell><mxCell id="p1_excel" value="&lt;b&gt;Upload Excel SOPd&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(/settings/konversi-data/jurnal-harian-produksi)&lt;/i&gt;&lt;br/&gt;&lt;hr/&gt;Import file Excel data SOPd (tabel &lt;code&gt;sopd&lt;/code&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#d97706;dashed=1;align=left;" vertex="1" parent="1">
  <mxGeometry x="300" y="215" width="260" height="75" as="geometry" />
</mxCell><mxCell id="p1_sopd" value="&lt;b&gt;Menu: SOPd (/jurnal-harian-produksi/data/excel-sopd)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Sumber Data:&lt;/b&gt; Menggabungkan data dari tabel &lt;code&gt;orders&lt;/code&gt; (Digit) &amp;amp; &lt;code&gt;sopd&lt;/code&gt; (Excel)&lt;br/&gt;• &lt;b&gt;Fungsi:&lt;/b&gt; Memuat antrean pesanan (No SOPd, Nama Order, Oplah, Deadline)&lt;br/&gt;• &lt;b&gt;Fitur:&lt;/b&gt; Inline edit cepat 2x klik cell untuk estimasi harga, deadline, dan keterangan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;align=left;" vertex="1" parent="1">
  <mxGeometry x="640" y="115" width="360" height="100" as="geometry" />
</mxCell><mxCell id="p1_sopd_info" value="&lt;b&gt;Daftar Antrean Order:&lt;/b&gt;&lt;br/&gt;No SOPd otomatis menjadi pilihan order kerja saat input penjadwalan di JHP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontSize=9.5;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1">
  <mxGeometry x="1040" y="125" width="240" height="75" as="geometry" />
</mxCell><mxCell id="p1_bg_step2" value="&lt;b&gt;2. HALAMAN KERJA: JURNAL HARIAN PRODUKSI (/jurnal-harian-produksi)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fecaca;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontColor=#b91c1c;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="40" y="320" width="1260" height="270" as="geometry" />
</mxCell><mxCell id="p1_master" value="&lt;b&gt;Master Pendukung:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Master Karyawan:&lt;/b&gt; Nama operator per bagian (/employees)&lt;br/&gt;• &lt;b&gt;Master Pekerjaan:&lt;/b&gt; Kategori &amp;amp; jenis pekerjaan (/data/master-pekerjaan-jurnal-produksi)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#b91c1c;align=left;dashed=1;" vertex="1" parent="1">
  <mxGeometry x="60" y="365" width="300" height="75" as="geometry" />
</mxCell><mxCell id="p1_telegram" value="&lt;b&gt;Jalur Alternatif: Bot Telegram&lt;/b&gt;&lt;br/&gt;&lt;code&gt;telegram-bot (/api/telegram/realisasi)&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Operator yang sudah di-approve di /settings/telegram-users dapat langsung mengirim realisasi via chat bot" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=1.5;align=left;" vertex="1" parent="1">
  <mxGeometry x="60" y="460" width="300" height="80" as="geometry" />
</mxCell><mxCell id="p1_jhp" value="&lt;b&gt;Menu: Jurnal Harian Produksi (JHP)&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/jurnal-harian-produksi&lt;/code&gt; [INTI OPERASIONAL]&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;CARA PAKAI DI HALAMAN INI:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;1. Penjadwalan (Target):&lt;/b&gt; Pilih Bagian (Cetak, Finishing, Setting, QC, Gudang, Teknisi, Mesin), Shift (1/2/3), Operator, No SOPd, Target&lt;br/&gt;   &lt;i&gt;(Tersedia tombol &#x27;Copy Jadwal&#x27; untuk menyalin susunan target dari hari sebelumnya)&lt;/i&gt;&lt;br/&gt;• &lt;b&gt;2. Input Realisasi:&lt;/b&gt; Operator isi Jam Mulai/Selesai &amp;amp; Lembar Berhasil&lt;br/&gt;• &lt;b&gt;3. Catat Rijek:&lt;/b&gt; Operator isi jumlah lembar rusak afdruk setup &amp;amp; jalan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=2;align=left;" vertex="1" parent="1">
  <mxGeometry x="470" y="355" width="460" height="195" as="geometry" />
</mxCell><mxCell id="p1_bg_step3" value="&lt;b&gt;3. MENU ANALISIS &amp;amp; REKAP HASIL (MENERIMA DATA DARI JHP)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#fbcfe8;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontColor=#9d174d;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="40" y="605" width="1260" height="160" as="geometry" />
</mxCell><mxCell id="p1_target" value="&lt;b&gt;Menu: Target Harian&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/jurnal-harian-produksi/target&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• Membaca data JHP per tanggal&lt;br/&gt;• Rekap pemenuhan target shift hari ini per bagian dan operator" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#db2777;align=left;" vertex="1" parent="1">
  <mxGeometry x="60" y="640" width="360" height="85" as="geometry" />
</mxCell><mxCell id="p1_analisa" value="&lt;b&gt;Menu: Analisa Produksi&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/jurnal-harian-produksi/analisa&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• Cari per &lt;b&gt;No Order / Faktur&lt;/b&gt;&lt;br/&gt;• Menampilkan seluruh riwayat entri pengerjaan di JHP, durasi jam, dan kendala yang tercatat" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#db2777;align=left;" vertex="1" parent="1">
  <mxGeometry x="470" y="640" width="380" height="85" as="geometry" />
</mxCell><mxCell id="p1_hasil" value="&lt;b&gt;Menu: Hasil Produksi&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/hasil-produksi&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Tab Jurnal Produksi:&lt;/b&gt; Rekap total target, realisasi lembar &amp;amp; rijek per jenis pekerjaan dari JHP&lt;br/&gt;• &lt;b&gt;Tab Barang Jadi:&lt;/b&gt; Data barang jadi dari Digit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#db2777;strokeWidth=2;align=left;" vertex="1" parent="1">
  <mxGeometry x="900" y="640" width="380" height="85" as="geometry" />
</mxCell><mxCell id="p1_e1" value="Tarik Order Produksi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=classic;endFill=1;fontSize=9.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1_erp" target="p1_sync">
