<mxfile host="Electron" modified="2026-10-04T00:00:00.000Z" agent="Mozilla/5.0" version="21.6.8" type="device">
  <diagram id="sintak-keseluruhan-lengkap" name="Keseluruhan SINTAK">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner" value="&lt;b&gt;ALIRAN DATA &amp;amp; ARSITEKTUR KESELURUHAN SINTAK (PT BUYA BAROKAH)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size: 11px; font-weight: normal; color: #475569;&#x27;&gt;Peta Alur Kerja &amp;amp; Seluruh Modul Berdasarkan Kode Sumber Asli: Login, Role Dev, Data Digit, Tracking Manufaktur, Produksi, dan Dashboard&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="40" y="20" width="1620" height="50" as="geometry" />
</mxCell><mxCell id="bg0" value="&lt;b&gt;0. AUTENTIKASI LOGIN &amp;amp; ROLE PENGGUNA (SESUAI DATABASE DEV)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf4ff;strokeColor=#f0abfc;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontColor=#86198f;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="40" y="85" width="1620" height="125" as="geometry" />
</mxCell><mxCell id="n_login" value="&lt;b&gt;Halaman Login (/login)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• Input Username &amp;amp; Password&lt;br/&gt;• Validasi kredensial di tabel &lt;code&gt;users&lt;/code&gt; (password hash bcrypt &amp;amp; status &lt;code&gt;is_active = 1&lt;/code&gt;)&lt;br/&gt;• Buat session cookie aman &amp;amp; redirect otomatis via &lt;code&gt;getFirstAccessibleRoute&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#a855f7;strokeWidth=2;align=left;" vertex="1" parent="1">
  <mxGeometry x="60" y="115" width="390" height="80" as="geometry" />
</mxCell><mxCell id="n_roles" value="&lt;b&gt;Daftar Role SINTAK (Berdasarkan database_dev.sqlite)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Manajemen / Admin:&lt;/b&gt; Super Admin, Admin Penjadwalan, Admin Realisasi&lt;br/&gt;• &lt;b&gt;Produksi &amp;amp; Bagian Teknis:&lt;/b&gt; Produksi, Kepala Seksi Pra Cetak, Kepala Seksi Pasca Cetak, Setting, Cetak, Finishing, Quality Control&lt;br/&gt;• &lt;b&gt;Kalkulasi, HRD &amp;amp; Keuangan:&lt;/b&gt; Kalkulasi, Kalkulasi2, HRD, Akunting | &lt;b&gt;Demo:&lt;/b&gt; Demo, Demo 2&lt;br/&gt;&lt;i&gt;*Hak akses tiap role diatur di tabel &lt;code&gt;role_permissions&lt;/code&gt; untuk memfilter menu sidebar yang tampil.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#a855f7;align=left;" vertex="1" parent="1">
  <mxGeometry x="500" y="115" width="1140" height="80" as="geometry" />
</mxCell><mxCell id="bg1" value="&lt;b&gt;1. DATA DIGIT (TARIKAN DATA DARI DIGIT VIA /sync)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-weight: normal; font-size: 10px; color: #0369a1;&#x27;&gt;Di SINTAK, kelompok ini murni menampilkan data hasil tarikan dari Digit, bukan tempat input transaksi baru:&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#bae6fd;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontColor=#0369a1;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="40" y="225" width="1620" height="140" as="geometry" />
</mxCell><mxCell id="n_digit" value="&lt;b&gt;DIGIT&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Sistem Eksternal)&lt;/i&gt;&lt;br/&gt;&lt;hr/&gt;Sumber data Order SO, Stok Barang,&lt;br/&gt;Pembelian, Hutang/Piutang &amp;amp; Jurnal" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
  <mxGeometry x="60" y="260" width="185" height="90" as="geometry" />
</mxCell><mxCell id="n_sync" value="&lt;b&gt;Sinkronisasi All Data&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/sync&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Modul SINTAK untuk menarik batch data dari Digit ke database lokal SQLite" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=2;align=left;" vertex="1" parent="1">
  <mxGeometry x="290" y="260" width="210" height="90" as="geometry" />
</mxCell><mxCell id="n_d_stok" value="&lt;b&gt;Stok: Master Barang&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/data-digit/stok/master-barang&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Data barang, barcode, saldo awal, masuk, keluar, saldo akhir, harga beli &amp;amp; jual dari Digit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#0284c7;align=left;" vertex="1" parent="1">
  <mxGeometry x="530" y="260" width="250" height="90" as="geometry" />
</mxCell><mxCell id="n_d_beli" value="&lt;b&gt;Pembelian (7 Menu Digit)&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/pr, /spph-out, /sph-in, /purchase-orders, /penerimaan-pembelian, /rekap-pembelian-barang, /pelunasan-hutang&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Data PR, penawaran harga, PO supplier, bukti terima barang, rekap pembelian &amp;amp; pelunasan hutang" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#0284c7;align=left;" vertex="1" parent="1">
  <mxGeometry x="810" y="260" width="270" height="90" as="geometry" />
</mxCell><mxCell id="n_d_jual" value="&lt;b&gt;Penjualan (5 Menu Digit)&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/sph-out, /sales-orders, /sales, /pengiriman, /pelunasan-piutang&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Data penawaran SPH, Sales Order (SO), faktur penjualan, Surat Jalan pengiriman &amp;amp; pelunasan piutang" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#0284c7;align=left;" vertex="1" parent="1">
  <mxGeometry x="1110" y="260" width="265" height="90" as="geometry" />
</mxCell><mxCell id="n_d_akt" value="&lt;b&gt;Akuntansi (2 Menu Digit)&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/akuntansi/data/rek-akuntansi&lt;/code&gt;&lt;br/&gt;&lt;code&gt;/akuntansi/laporan/jurnal-umum&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Master bagan akun (COA) dan transaksi Jurnal Umum (Debet, Kredit, Laba Rugi). Tombol &#x27;Analisis Jurnal&#x27;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#0284c7;align=left;" vertex="1" parent="1">
  <mxGeometry x="1405" y="260" width="235" height="90" as="geometry" />
</mxCell><mxCell id="bg2" value="&lt;b&gt;2. PELACAKAN DOKUMEN MANUFAKTUR &amp;amp; PERSIAPAN ORDER (SOPd)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#ddd6fe;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontColor=#6d28d9;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="40" y="380" width="1620" height="135" as="geometry" />
</mxCell><mxCell id="n_sopd" value="&lt;b&gt;Menu: SOPd (/data/excel-sopd)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Sumber Data:&lt;/b&gt; Menggabungkan Order dari Digit (tabel &lt;code&gt;orders&lt;/code&gt;) &amp;amp; upload Excel SOPd (tabel &lt;code&gt;sopd&lt;/code&gt;)&lt;br/&gt;• &lt;b&gt;Fungsi:&lt;/b&gt; Memuat antrean pesanan (No SOPd, Nama Order, Oplah, Deadline, Harga)&lt;br/&gt;• &lt;b&gt;Fitur:&lt;/b&gt; Edit cepat 2x klik cell untuk estimasi harga, deadline, dan keterangan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;align=left;" vertex="1" parent="1">
  <mxGeometry x="60" y="410" width="370" height="90" as="geometry" />
</mxCell><mxCell id="n_excel_sopd" value="&lt;b&gt;Upload Excel SOPd&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(/settings/konversi-data/jurnal-harian-produksi)&lt;/i&gt;&lt;br/&gt;&lt;hr/&gt;Fasilitas upload file Excel data SOPd" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#d97706;dashed=1;align=left;" vertex="1" parent="1">
  <mxGeometry x="500" y="415" width="240" height="75" as="geometry" />
</mxCell><mxCell id="n_tracking" value="&lt;b&gt;Menu: Tracking Manufaktur (/tracking-manufaktur)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;Lacak alur siklus hidup dokumen manufaktur dari Digit secara terpadu:&lt;/b&gt;&lt;br/&gt;&lt;code&gt;Sales Order (SO) -&gt; Order Produksi -&gt; BOM -&gt; PR / PO -&gt; Penerimaan Barang -&gt; BBB -&gt; Barang Jadi -&gt; Pengiriman (SJ) -&gt; Pelunasan Piutang&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=2;align=left;" vertex="1" parent="1">
  <mxGeometry x="770" y="410" width="870" height="90" as="geometry" />
</mxCell><mxCell id="bg3" value="&lt;b&gt;3. OPERASIONAL PRODUKSI SINTAK (JURNAL HARIAN PRODUKSI, TARGET, ANALISA, HASIL &amp;amp; LAPORAN)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fecaca;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontColor=#b91c1c;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="40" y="530" width="1620" height="245" as="geometry" />
</mxCell><mxCell id="n_master" value="&lt;b&gt;Master Pendukung:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Master Karyawan:&lt;/b&gt; Nama operator per bagian (/employees)&lt;br/&gt;• &lt;b&gt;Master Pekerjaan:&lt;/b&gt; Kategori &amp;amp; jenis pekerjaan (/data/master-pekerjaan-jurnal-produksi)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#b91c1c;align=left;dashed=1;" vertex="1" parent="1">
  <mxGeometry x="60" y="565" width="290" height="75" as="geometry" />
</mxCell><mxCell id="n_telegram" value="&lt;b&gt;Input Realisasi via Bot Telegram&lt;/b&gt;&lt;br/&gt;&lt;code&gt;telegram-bot (/api/telegram/realisasi)&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Operator yang sudah disetujui di /settings/telegram-users dapat langsung mengirim realisasi kerja via chat bot Telegram" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=1.5;align=left;" vertex="1" parent="1">
  <mxGeometry x="60" y="665" width="290" height="75" as="geometry" />
</mxCell><mxCell id="n_jhp" value="&lt;b&gt;Menu: Jurnal Harian Produksi (JHP)&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/jurnal-harian-produksi&lt;/code&gt; [INTI OPERASIONAL PRODUKSI]&lt;br/&gt;&lt;hr/&gt;&lt;b&gt;CARA PAKAI DI HALAMAN INI:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;1. Penjadwalan (Target):&lt;/b&gt; Pilih Bagian (Cetak, Finishing, Setting, QC, Gudang, Teknisi, Mesin), Shift (1/2/3), Operator, No SOPd, Target&lt;br/&gt;   &lt;i&gt;(Tersedia tombol &#x27;Copy Jadwal&#x27; untuk menyalin susunan target dari hari sebelumnya)&lt;/i&gt;&lt;br/&gt;• &lt;b&gt;2. Input Realisasi:&lt;/b&gt; Operator isi Jam Mulai/Selesai &amp;amp; Lembar Berhasil&lt;br/&gt;• &lt;b&gt;3. Catat Rijek:&lt;/b&gt; Operator isi jumlah lembar rusak afdruk setup &amp;amp; jalan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=2;align=left;" vertex="1" parent="1">
  <mxGeometry x="400" y="560" width="480" height="185" as="geometry" />
</mxCell><mxCell id="n_target" value="&lt;b&gt;Menu: Target Harian&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/jurnal-harian-produksi/target&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Rekap pemenuhan target shift hari ini per bagian dan operator" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#db2777;align=left;" vertex="1" parent="1">
  <mxGeometry x="930" y="560" width="330" height="55" as="geometry" />
</mxCell><mxCell id="n_analisa" value="&lt;b&gt;Menu: Analisa Produksi&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/jurnal-harian-produksi/analisa&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Cari per &lt;b&gt;No Order / Faktur&lt;/b&gt;: rekap seluruh entri pengerjaan di JHP, durasi jam, dan kendala yang tercatat" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#db2777;align=left;" vertex="1" parent="1">
  <mxGeometry x="930" y="625" width="330" height="55" as="geometry" />
</mxCell><mxCell id="n_hasil" value="&lt;b&gt;Menu: Hasil Produksi&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/hasil-produksi&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Tab Jurnal:&lt;/b&gt; Total target, realisasi &amp;amp; rijek per jenis pekerjaan dari JHP&lt;br/&gt;• &lt;b&gt;Tab Barang Jadi:&lt;/b&gt; Data barang jadi hasil produksi dari Digit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#db2777;strokeWidth=1.5;align=left;" vertex="1" parent="1">
  <mxGeometry x="930" y="690" width="330" height="55" as="geometry" />
</mxCell><mxCell id="n_lap_pek" value="&lt;b&gt;Menu: Laporan Pekerjaan&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/laporan-pekerjaan&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;Monitoring &amp;amp; pelaporan tugas kerja harian per karyawan dan bagian (Setting, QC, Cetak, Finishing, Gudang, Teknisi, Mesin)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#db2777;align=left;" vertex="1" parent="1">
  <mxGeometry x="1290" y="560" width="350" height="185" as="geometry" />
</mxCell><mxCell id="bg4" value="&lt;b&gt;4. KALKULASI, HRD &amp;amp; PENGATURAN SISTEM (MODUL-MODUL OPERASIONAL MANDIRI)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fde68a;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontColor=#b45309;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="40" y="790" width="1620" height="140" as="geometry" />
</mxCell><mxCell id="n_calc" value="&lt;b&gt;Kalkulasi: Pricelist &amp;amp; HPP&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/pricelist&lt;/code&gt; &amp;amp; &lt;code&gt;/hpp-kalkulasi&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Pricelist:&lt;/b&gt; Simulator mandiri 20+ produk cetak (Buku, Dus, Stopmap, Brosur, Undangan, dll.)&lt;br/&gt;• &lt;b&gt;HPP Kalkulasi:&lt;/b&gt; Input nilai HPP per nama order&lt;br/&gt;• &lt;b&gt;Rekap SO:&lt;/b&gt; Rekap detail baris Sales Order dari Digit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#d97706;align=left;" vertex="1" parent="1">
  <mxGeometry x="60" y="825" width="480" height="90" as="geometry" />
</mxCell><mxCell id="n_hrd" value="&lt;b&gt;HRD: Karyawan &amp;amp; Catat Kesalahan&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/employees&lt;/code&gt; &amp;amp; &lt;code&gt;/records&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Karyawan:&lt;/b&gt; Master NIP, Nama, Jabatan, Bagian, Status Aktif&lt;br/&gt;• &lt;b&gt;Catat Kesalahan:&lt;/b&gt; Pencatatan insiden kelalaian kerja &amp;amp; rincian beban kerugian finansial (mengalir ke Dashboard HRD)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#e11d48;align=left;" vertex="1" parent="1">
  <mxGeometry x="570" y="825" width="480" height="90" as="geometry" />
</mxCell><mxCell id="n_settings" value="&lt;b&gt;Pengaturan: User, Roles, Konversi &amp;amp; Log&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/users&lt;/code&gt;, &lt;code&gt;/roles&lt;/code&gt;, &lt;code&gt;/settings/...&lt;/code&gt;, &lt;code&gt;/log-aktivitas&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;Kelola User &amp;amp; Hak Akses:&lt;/b&gt; Manajemen akun login &amp;amp; permission RBAC&lt;br/&gt;• &lt;b&gt;Telegram Users:&lt;/b&gt; Approval akun operator untuk Bot Telegram&lt;br/&gt;• &lt;b&gt;Konversi Data:&lt;/b&gt; Migrasi file Excel HPP, JHP, dan Laporan | &lt;b&gt;Log:&lt;/b&gt; Audit trail aktivitas sistem" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#475569;align=left;" vertex="1" parent="1">
  <mxGeometry x="1080" y="825" width="560" height="90" as="geometry" />
</mxCell><mxCell id="bg5" value="&lt;b&gt;5. KELOMPOK DASHBOARD (4 DASHBOARD EKSEKUTIF)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-weight: normal; font-size: 10px; color: #047857;&#x27;&gt;Masing-masing dashboard membaca query database secara mandiri untuk menyajikan grafik dan kartu statistik:&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=15;spacingTop=6;fontColor=#047857;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="40" y="945" width="1620" height="145" as="geometry" />
</mxCell><mxCell id="n_dash_umum" value="&lt;b&gt;Dashboard Umum&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/dashboard&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;UsersStatCard:&lt;/b&gt; Statistik jumlah user sistem &amp;amp; role&lt;br/&gt;• &lt;b&gt;Akses Cepat:&lt;/b&gt; Pintasan ke menu administrasi&lt;br/&gt;• &lt;b&gt;AktivitasTerbaruCard:&lt;/b&gt; Log 8 aktivitas sistem terbaru dari tabel &lt;code&gt;activity_logs&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#059669;align=left;" vertex="1" parent="1">
  <mxGeometry x="60" y="985" width="360" height="85" as="geometry" />
</mxCell><mxCell id="n_dash_manufaktur" value="&lt;b&gt;Dashboard Produksi&lt;/b&gt;&lt;br/&gt;&lt;code&gt;/dashboard-manufaktur&lt;/code&gt;&lt;br/&gt;&lt;hr/&gt;• &lt;b&gt;OrdersStatCard:&lt;/b&gt; Statistik total order produksi dari Digit&lt;br/&gt;• &lt;b&gt;JurnalStatCard:&lt;/b&gt; Target vs Realisasi lembar cetak JHP&lt;br/&gt;• &lt;b&gt;ProduksiTrendChart:&lt;/b&gt; Grafik tren BBB &amp;amp; Hasil Produksi&lt;br/&gt;• &lt;b&gt;JurnalTerbaruCard:&lt;/b&gt; Daftar jurnal produksi terbaru" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#059669;align=left;" vertex="1" parent="1">
  <mxGeometry x="450" y="985" width="370" height="85" as="geometry" />
