</mxCell><mxCell id="st1_2" value="&lt;b&gt;Buka Dashboard Produksi (/dashboard-manufaktur) &amp;rarr;&lt;/b&gt;&lt;br/&gt;• Pantau total pesanan (OrdersStatCard)&lt;br/&gt;• Pantau rasio Target vs Realisasi lembar (JurnalStatCard)&lt;br/&gt;• Pantau grafik tren BBB &amp;amp; Hasil Produksi (ProduksiTrendChart)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9.5;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;fillColor=#ffffff;strokeColor=#ef4444;align=left;" vertex="1" parent="1">
