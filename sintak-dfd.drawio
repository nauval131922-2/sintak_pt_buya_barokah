  <diagram id="dfd_level_2_penjualan" name="DFD Level 2 - 2.0 Penjualan &amp; Piutang">
    <mxGraphModel dx="1422" dy="798" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="820" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="b5_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#1e293b;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2040" height="60" as="geometry" /></mxCell><mxCell id="b5_txt" value="DATA FLOW DIAGRAM (DFD) LEVEL 2 - PROSES 2.0: PENJUALAN &amp; PIUTANG&#10;PT BUYA BAROKAH" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2040" height="60" as="geometry" /></mxCell><mxCell id="e5_digit_so" value="DIGIT ERP: PENJUALAN&#10;(SPH Keluar &amp; Sales Order Barang)" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="480" height="65" as="geometry" /></mxCell><mxCell id="e5_kalkulasi_so" value="TIM KALKULASI &amp; PENJUALAN&#10;(Filter Harga Jual &amp; Analisis Riwayat SO)" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;" vertex="1" parent="1"><mxGeometry x="560" y="95" width="480" height="65" as="geometry" /></mxCell><mxCell id="e5_digit_si" value="DIGIT ERP: REALISASI PENJUALAN&#10;(Laporan Penjualan / Faktur SI)" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="1080" y="95" width="480" height="65" as="geometry" /></mxCell><mxCell id="e5_digit_kirim" value="DIGIT ERP: PENGIRIMAN &amp; PIUTANG&#10;(Surat Jalan Pengiriman &amp; Pelunasan Piutang)" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="1600" y="95" width="480" height="65" as="geometry" /></mxCell><mxCell id="p_2_1" value="2.1 PENAWARAN &amp; PEMESANAN PENJUALAN&#10;&#10;• Scrape SPH Keluar (Penawaran harga resmi ke pelanggan)&#10;• Scrape Sales Order Barang (Faktur SO, tgl, nama produk, oplah qty, harga)&#10;• Monitoring Status Pesanan Penjualan &amp; Referensi Faktur Pelanggan&#10;• Menyimpan Data Hulu Rantai Transaksi Penjualan" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="480" height="140" as="geometry" /></mxCell><mxCell id="p_2_2" value="2.2 ANALISIS DETAIL SALES ORDER BARANG&#10;&#10;• Membaca Baris Data Detail dari Tabel sales_orders&#10;• Filter Berdasarkan Rentang Harga Jual Satuan (Min - Max Harga)&#10;• Pencarian Cepat per Nomor Faktur SO, Nama Produk, atau Pelanggan&#10;• Digunakan Khusus oleh Tim Kalkulasi (Izin: kalkulasi_rekap_so)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;" vertex="1" parent="1"><mxGeometry x="560" y="230" width="480" height="140" as="geometry" /></mxCell><mxCell id="p_2_3" value="2.3 REALISASI PENJUALAN (FAKTUR SI)&#10;&#10;• Scrape Laporan Penjualan (Faktur SI dari Digit)&#10;• Relasi Rantai Transaksi: Terikat langsung ke Faktur SO (FK: faktur_so)&#10;• Validasi Tanggal Jatuh Tempo, Nilai Jumlah, PPN, dan Total Tagihan&#10;• Dasar Penagihan Piutang dan Surat Jalan Pengiriman" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="1080" y="230" width="480" height="140" as="geometry" /></mxCell><mxCell id="p_2_4" value="2.4 PENGIRIMAN &amp; PELUNASAN PIUTANG&#10;&#10;• Scrape Surat Jalan Pengiriman (SJ: No Resi, Supir, Armada, Status Kirim)&#10;• Relasi Pengiriman: Terikat ke Laporan Penjualan (faktur_si / status_faktur)&#10;• Scrape Pelunasan Piutang (Pencatatan kredit dan tanggal bayar pelanggan)&#10;• Rekap Status Piutang Lunas vs Piutang Tertunggak" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="1600" y="230" width="480" height="140" as="geometry" /></mxCell><mxCell id="ds_2_d3_so" value="D3.1 | Penawaran &amp; Sales Order&#10;&#10;• sph_out (faktur, tgl, perihal, grand_total, status)&#10;• sales_orders (faktur, tgl, faktur_sph, kd_barang, qty, harga)" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="480" height="120" as="geometry" /></mxCell><mxCell id="box_2_note" value="SUMBER DATA ANALISIS DETAIL SO:&#10;&#10;• Dibaca secara dinamis dari tabel sales_orders (D3.1)&#10;• Tidak memerlukan tabel penyimpanan terpisah&#10;[Query Dinamis: Filter Nilai Rupiah Harga Satuan]" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#faf5ff;strokeColor=#9333ea;fontSize=8.5;fontStyle=0;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="560" y="460" width="480" height="120" as="geometry" /></mxCell><mxCell id="ds_2_d3_si" value="D3.2 | Laporan Penjualan (SI)&#10;&#10;• sales_reports&#10;(faktur, tgl, kd_pelanggan, faktur_so, harga, qty, jumlah, ppn)" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1080" y="460" width="480" height="120" as="geometry" /></mxCell><mxCell id="ds_2_d3_kirim" value="D3.3 | Pengiriman &amp; Piutang&#10;&#10;• pengiriman (faktur, tgl, no_resi, status_faktur, kd_supir)&#10;• pelunasan_piutang (faktur, fkt, tgl, kredit, kd_pelanggan)" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1600" y="460" width="480" height="120" as="geometry" /></mxCell><mxCell id="out_2_track" value="6.0 TRACKING MANUFAKTUR (/tracking-manufaktur)&#10;&#10;Pelacakan Rantai Penjualan Terpadu:&#10;SPH Out ⇄ Sales Order ⇄ Laporan Penjualan ⇄ Pengiriman (SJ) ⇄ Pelunasan Piutang" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#4338ca;strokeColor=#312e81;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="480" height="80" as="geometry" /></mxCell><mxCell id="out_2_rekso" value="REKAP SALES ORDER BARANG (/rekap-sales-order)&#10;&#10;Viewer Baris Detail Sales Order dengan Filter Harga Satuan&#10;untuk Riset Pasar &amp; Referensi Penawaran Tim Kalkulasi" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#581c87;strokeColor=#3b0764;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="680" width="480" height="80" as="geometry" /></mxCell><mxCell id="out_2_si_view" value="LAPORAN PENJUALAN (/sales)&#10;&#10;Monitoring Realisasi Faktur Penjualan (SI) dari Digit" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#ca8a04;strokeColor=#854d0e;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1080" y="680" width="480" height="80" as="geometry" /></mxCell><mxCell id="out_2_piut_view" value="MONITORING PENGIRIMAN &amp; PIUTANG&#10;&#10;• Pengiriman Barang (/pengiriman - Status Surat Jalan Pengiriman)&#10;• Pelunasan Piutang (/pelunasan-piutang - Riwayat Pembayaran Tagihan)" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#0f172a;strokeColor=#1e293b;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1600" y="680" width="480" height="80" as="geometry" /></mxCell><mxCell id="e_d_p21" value="Scraping SPH &amp; SO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e5_digit_so" target="p_2_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_k_p22" value="Kriteria Filter Harga" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e5_kalkulasi_so" target="p_2_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d_p23" value="Scraping Faktur SI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e5_digit_si" target="p_2_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d_p24" value="Scraping Surat Jalan &amp; Piutang" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e5_digit_kirim" target="p_2_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d31_p22" value="Query Baris sales_orders" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;fontSize=8.5;fontColor=#047857;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.25;entryX=0;entryY=0.6;" edge="1" parent="1" source="ds_2_d3_so" target="p_2_2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="535" y="490" /><mxPoint x="535" y="314" /></Array></mxGeometry></mxCell><mxCell id="e_p21_d3" value="Simpan SPH &amp; SO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_2_1" target="ds_2_d3_so"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_p23_d3" value="Simpan Faktur Penjualan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_2_3" target="ds_2_d3_si"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_p24_d3" value="Simpan Pengiriman &amp; Bayar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_2_4" target="ds_2_d3_kirim"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d3so_track" value="Alur SPH &amp; Sales Order" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2;fontSize=9.5;fontColor=#6d28d9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ds_2_d3_so" target="out_2_track"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_p22_view" value="Penyajian Baris &amp; Filter Harga" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="box_2_note" target="out_2_rekso"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d3si_ui" value="Penyajian Faktur SI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ds_2_d3_si" target="out_2_si_view"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d3kirim_ui" value="Status Surat Jalan &amp; Piutang" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ds_2_d3_kirim" target="out_2_piut_view"><mxGeometry relative="1" as="geometry" /></mxCell>
