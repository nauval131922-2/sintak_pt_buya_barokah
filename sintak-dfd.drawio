  <diagram id="dfd_level_2_prod" name="DFD Level 2 - 3.0 Operasional Produksi">
    <mxGraphModel dx="1422" dy="798" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="800" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="b3_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#1e293b;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2120" height="60" as="geometry" /></mxCell><mxCell id="b3_txt" value="DATA FLOW DIAGRAM (DFD) LEVEL 2 - PROSES 3.0: OPERASIONAL PRODUKSI&#10;PT BUYA BAROKAH" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2120" height="60" as="geometry" /></mxCell><mxCell id="e3_digit_mfg" value="DIGIT:&#10;MANUFAKTUR&#10;(BOM, Orders, BBB, Hasil, Selesai)" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="330" height="65" as="geometry" /></mxCell><mxCell id="e3_admin_penj" value="ADMIN PENJADWALAN&#10;(Buat Jadwal Target Harian &amp;&#10;Kelola 2 Master Pekerjaan)" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="400" y="95" width="320" height="65" as="geometry" /></mxCell><mxCell id="e3_realisasi_actors" value="REALISASI LAPANGAN:&#10;• Admin Realisasi (Verifikasi Web)&#10;• Operator (Input Bot Telegram)" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="750" y="95" width="410" height="65" as="geometry" /></mxCell><mxCell id="e3_kasi_supervisor" value="KEPALA SEKSI &amp; SUPERVISOR:&#10;Monitoring Produksi &amp; Analisa Order" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="1190" y="95" width="430" height="65" as="geometry" /></mxCell><mxCell id="e3_operator_tek" value="OPERATOR LAPANGAN &amp; KEPALA SEKSI:&#10;Divisi Setting, QC, Cetak, Finishing, Gudang, Teknisi, Mesin" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#fdf4ff;strokeColor=#c026d3;fontColor=#701a75;" vertex="1" parent="1"><mxGeometry x="1650" y="95" width="510" height="65" as="geometry" /></mxCell><mxCell id="p_3_1" value="3.1 SINKRONISASI DATA PRODUKSI DIGIT&#10;&#10;• Scrape Bill of Material (BOM)&#10;• Scrape Order Produksi (faktur, tgl, deadline, status)&#10;• Scrape Pemakaian Bahan Baku (BBB)&#10;• Scrape Barang Jadi &amp; Produksi Selesai" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="330" height="140" as="geometry" /></mxCell><mxCell id="p_3_2" value="3.2 PENGELOLAAN DATA REFERENSI PRODUKSI&#10;&#10;• Referensi Order: Otomatis dari Digit orders (Arsip ≤ 2024 via Excel)&#10;• Master Pekerjaan: Unggah Kode, Kategori &amp; Target Standar&#10;• Master Pekerjaan JHP: Kelola Nama Pekerjaan Dropdown JHP&#10;• Menyediakan Opsi Dropdown Dinamis untuk Form JHP" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="400" y="230" width="320" height="140" as="geometry" /></mxCell><mxCell id="p_3_3" value="3.3 PENJADWALAN &amp; PENCATATAN REALISASI JHP&#10;&#10;• Form Penjadwalan: Shift, Operator, No Order, Target &amp; Jam&#10;• Form Web Realisasi: Lembar Jadi, Inscheet, Rijek, Kendala&#10;• Webhook Telegram Bot: Input Realisasi Lapangan Berbasis Order&#10;• Validasi Akun Telegram &amp; Tanggal Input (Maks 7 Hari)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="750" y="230" width="410" height="140" as="geometry" /></mxCell><mxCell id="p_3_4" value="3.4 ANALISA &amp; MONITORING HASIL PRODUKSI&#10;&#10;• Target Harian: Evaluasi Capaian Target vs Realisasi per Shift&#10;• Analisa Order: Rekap Pengerjaan Order Lintas Bagian/Mesin&#10;• Hasil Produksi: Rekap Akumulasi Lembar Realisasi vs Barang Jadi&#10;• Dashboard Manufaktur: Visualisasi Tren Produksi &amp; Bahan Baku" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="1190" y="230" width="430" height="140" as="geometry" /></mxCell><mxCell id="p_3_5" value="3.5 PELAPORAN TUGAS LAPANGAN (LAPORAN PEKERJAAN)&#10;&#10;• Input Task 7 Divisi: Setting, QC, Cetak, Finishing, Gudang, Teknisi, Mesin&#10;• Rujukan Proyek: Baca No Order dari Referensi Orders / SOPd&#10;• Pengelolaan Status Tugas: Belum Dikerjakan, In Progress, Selesai, Cancel&#10;• Hak Akses Terpisah: Dikelola per role divisi teknis" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#fdf4ff;strokeColor=#c026d3;fontColor=#701a75;" vertex="1" parent="1"><mxGeometry x="1650" y="230" width="510" height="140" as="geometry" /></mxCell><mxCell id="ds_3_d4" value="D4 | Produksi Digit&#10;&#10;• bill_of_materials (faktur, formula)&#10;• orders (faktur_prd, tgl, deadline, status)&#10;• bahan_baku (faktur_pb, pemakaian)&#10;• barang_jadi &amp; produksi_selesai" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="330" height="110" as="geometry" /></mxCell><mxCell id="ds_3_ref" value="DATA REFERENSI PRODUKSI&#10;&#10;• orders / sopd (nama_order otomatis dari Digit)&#10;• master_pekerjaan (kode &amp; target standar)&#10;• master_pekerjaan_jurnal_produksi (opsi form JHP)&#10;[Hanya Dibaca sebagai Dropdown &amp; Standar]" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;strokeColor=#059669;fillColor=#ecfdf5;" vertex="1" parent="1"><mxGeometry x="400" y="440" width="320" height="110" as="geometry" /></mxCell><mxCell id="ds_3_d5" value="D5 | Jurnal Harian Produksi (JHP)&#10;&#10;• jurnal_harian_produksi&#10;(posisi, absensi, tgl, shift, nama_karyawan, bagian,&#10;no_order, nama_order, target, realisasi, inscheet,&#10;rijek, kendala, jam, created_by)" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="750" y="440" width="410" height="110" as="geometry" /></mxCell><mxCell id="ds_3_agg" value="REKAP AKUMULASI PRODUKSI&#10;&#10;• View Akumulasi Hasil Realisasi JHP&#10;• Rekonsiliasi Fisik Barang Jadi Digit&#10;• Pemetaan Kode dari master_pekerjaan" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;strokeColor=#ca8a04;fillColor=#fefce8;" vertex="1" parent="1"><mxGeometry x="1190" y="440" width="430" height="110" as="geometry" /></mxCell><mxCell id="ds_3_d6" value="D6 | Laporan Pekerjaan&#10;&#10;• laporan_pekerjaan (log tugas 7 divisi)&#10;• role_laporan_pekerjaan_config&#10;  (konfigurasi hak akses &amp; scope divisi)" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1650" y="440" width="510" height="110" as="geometry" /></mxCell><mxCell id="out_tracking" value="6.0 TRACKING MANUFAKTUR&#10;(/tracking-manufaktur)&#10;Pelacakan Siklus Manufaktur Terintegrasi:&#10;BOM ⇄ Order Produksi ⇄ Bahan Baku ⇄ Barang Jadi" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#4338ca;strokeColor=#312e81;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="330" height="80" as="geometry" /></mxCell><mxCell id="out_ref_lookup" value="LOOKUP DROPDOWN SISTEM&#10;&#10;Referensi Terbuka untuk Form JHP,&#10;Laporan Pekerjaan, dan Simulator Pricelist" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#065f46;strokeColor=#064e3b;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="660" width="320" height="80" as="geometry" /></mxCell><mxCell id="out_evaluasi" value="EVALUASI TARGET &amp; RIWAYAT ORDER&#10;&#10;• Target Harian (/jurnal-harian-produksi/target): Filter Tgl &amp; Rekap Shift&#10;• Analisa Order (/jurnal-harian-produksi/analisa): Lacak Jejak Order Spesifik" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="750" y="660" width="410" height="80" as="geometry" /></mxCell><mxCell id="out_dashboard" value="DASHBOARD MANUFAKTUR &amp; HASIL PRODUKSI&#10;&#10;• Dashboard Manufaktur (/dashboard-manufaktur): Grafik Tren BBB vs Hasil&#10;• Hasil Produksi (/hasil-produksi): Dual