          <mxGeometry height="65" width="480" x="1600" y="95" as="geometry" />
        </mxCell>
        <mxCell id="p_1_1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;" value="1.1 PENGADAAN AWAL (PERMINTAAN &amp; PENAWARAN)&#xa;&#xa;• Scrape Purchase Request (PR: kebutuhan bahan baku/cetak)&#xa;• Scrape SPPH (Surat Permintaan Penawaran Harga ke supplier)&#xa;• Scrape SPH Masuk (Surat Penawaran Harga &amp; syarat pembayaran supplier)&#xa;• Filter Status Pengadaan &amp; Tanggal Kebutuhan" vertex="1">
          <mxGeometry height="140" width="480" x="40" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p_1_2" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;" value="1.2 PEMESANAN &amp; PENERIMAAN FISIK&#xa;&#xa;• Scrape Purchase Order (PO resmi ke supplier terpilih)&#xa;• Scrape Penerimaan Pembelian (Surat jalan masuk barang fisik)&#xa;• Validasi Gudang Penerima &amp; Tanggal Kirim Supplier&#xa;• Monitoring Status Selesai / Parsial Order Pembelian" vertex="1">
          <mxGeometry height="140" width="480" x="560" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p_1_3" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;" value="1.3 REKAP PEMBELIAN BARANG &amp; HUTANG&#xa;&#xa;• Scrape Rekap PB (Detail baris item: nama barang, qty, harga satuan)&#xa;• Scrape Pelunasan Hutang (Bukti bayar, no rekening, tanggal bayar)&#xa;• Menyediakan Sumber Data Lookup Harga Beli Bahan untuk Kalkulasi&#xa;• Rekap Total Kewajiban Hutang Usaha per Supplier" vertex="1">
          <mxGeometry height="140" width="480" x="1080" y="230" as="geometry" />
        </mxCell>
