        <mxCell id="e3_kasi_supervisor" parent="1" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" value="KEPALA SEKSI &amp; SUPERVISOR:&#10;Monitoring Produksi &amp; Analisa Order" vertex="1">
          <mxGeometry height="65" width="440" x="1180" y="95" as="geometry" />
        </mxCell>
        <mxCell id="e3_operator_tek" parent="1" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#fdf4ff;strokeColor=#c026d3;fontColor=#701a75;" value="OPERATOR LAPANGAN &amp; KEPALA SEKSI:&#10;Divisi Setting, QC, Cetak, Finishing, Gudang, Teknisi, Mesin" vertex="1">
          <mxGeometry height="65" width="480" x="1670" y="95" as="geometry" />
        </mxCell>
        <mxCell id="p_3_1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;" value="3.1 SINKRONISASI DATA PRODUKSI DIGIT&#10;&#10;• Scrape Bill of Material (BOM)&#10;• Scrape Order Produksi (faktur, tgl, deadline, status)&#10;• Scrape Pemakaian Bahan Baku (BBB)&#10;• Scrape Barang Jadi &amp; Produksi Selesai" vertex="1">
          <mxGeometry height="140" width="300" x="40" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p_3_2" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;" value="3.2 PENGELOLAAN DATA REFERENSI PRODUKSI&#10;&#10;• Referensi Order: Otomatis dari Digit orders (Arsip ≤ 2024 via Excel)&#10;• Master Pekerjaan: Unggah Kode, Kategori &amp; Target Standar&#10;• Master Pekerjaan JHP: Kelola Nama Pekerjaan Dropdown JHP&#10;• Menyediakan Opsi Dropdown Dinamis untuk Form JHP" vertex="1">
          <mxGeometry height="140" width="310" x="390" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p_3_3" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;" value="3.3 PENJADWALAN &amp; PENCATATAN REALISASI JHP&#10;&#10;• Form Penjadwalan: Shift, Operator, No Order, Target &amp; Jam&#10;• Form Web Realisasi: Lembar Jadi, Inscheet, Rijek, Kendala&#10;• Webhook Telegram Bot: Input Realisasi Lapangan Berbasis Order&#10;• Validasi Akun Telegram &amp; Tanggal Input (Maks 7 Hari)" vertex="1">
          <mxGeometry height="140" width="380" x="750" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p_3_4" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" value="3.4 ANALISA &amp; MONITORING PRODUKSI&#10;&#10;• Laporan Harian: Lembar Shift Kerja Lapangan &amp; Cetak Jadwal (/target)&#10;• Analisa Order: Lacak Kronologi &amp; Kendala Pengerjaan per No Order (/analisa)&#10;• Hasil Produksi: Hitung Akumulasi Lembar JHP vs Data Barang Jadi Digit (/hasil-produksi)&#10;• Dashboard Manufaktur: Visualisasi Grafik Tren Pemakaian Bahan vs Hasil" vertex="1">
          <mxGeometry height="140" width="440" x="1180" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p_3_5" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#fdf4ff;strokeColor=#c026d3;fontColor=#701a75;" value="3.5 PELAPORAN TUGAS LAPANGAN (LAPORAN PEKERJAAN)&#10;&#10;• Input Task 7 Divisi: Setting, QC, Cetak, Finishing, Gudang, Teknisi, Mesin&#10;• Rujukan Proyek: Baca No Order dari Referensi Orders / SOPd&#10;• Pengelolaan Status Tugas: Belum Dikerjakan, In Progress, Selesai, Cancel&#10;• Hak Akses Terpisah: Dikelola per role divisi teknis" vertex="1">
          <mxGeometry height="140" width="480" x="1670" y="230" as="geometry" />
        </mxCell>
        <mxCell id="ds_3_d4" parent="1" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" value="D4 | Produksi Digit&#10;&#10;• bill_of_materials (faktur, formula)&#10;• orders (faktur_prd, tgl, deadline, status)&#10;• bahan_baku (faktur_pb, pemakaian)&#10;• barang_jadi &amp; produksi_selesai" vertex="1">
          <mxGeometry height="120" width="300" x="40" y="460" as="geometry" />
        </mxCell>
        <mxCell id="ds_3_ref" parent="1" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;strokeColor=#059669;fillColor=#ecfdf5;" value="DATA REFERENSI PRODUKSI&#10;&#10;• orders / sopd (nama_order otomatis dari Digit)&#10;• master_pekerjaan (kode &amp; target standar)&#10;• master_pekerjaan_jurnal_produksi (opsi form JHP)&#10;[Hanya Dibaca sebagai Dropdown &amp; Standar]" vertex="1">
          <mxGeometry height="120" width="310" x="390" y="460" as="geometry" />
        </mxCell>
        <mxCell id="ds_3_d5" parent="1" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" value="D5 | Jurnal Harian Produksi (JHP)&#10;&#10;• jurnal_harian_produksi&#10;(posisi, absensi, tgl, shift, nama_karyawan, bagian,&#10;no_order, nama_order, target, realisasi, inscheet,&#10;rijek, kendala, jam, created_by)" vertex="1">
          <mxGeometry height="120" width="380" x="750" y="460" as="geometry" />
