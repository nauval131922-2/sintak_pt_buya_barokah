        <mxCell id="ds_3_d5" parent="1" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" value="D5 | Jurnal Harian Produksi (JHP)&#xa;&#xa;• jurnal_harian_produksi&#xa;(posisi, absensi, tgl, shift, nama_karyawan, bagian,&#xa;no_order, nama_order, target, realisasi, inscheet,&#xa;rijek, kendala, jam, created_by)" vertex="1">
