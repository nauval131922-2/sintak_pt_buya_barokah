        <mxCell id="box_3_source" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fefce8;strokeColor=#ca8a04;fontSize=8.5;fontStyle=0;align=left;spacingLeft=8;spacingTop=6;" value="SUMBER DATA ANALISIS &amp; MONITORING:&#xa;&#xa;• Data Log Transaksi Riil dibaca dari Data Store D5&#xa;• Data Barang Jadi Pembanding dibaca dari Data Store D4&#xa;[Query Dinamis: Agregasi Lembar Jadi, Rijek &amp; Tren Mesin]" vertex="1">
