nasan Hutang&#xa;• Tarik Data Master Stok Barang" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=11;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="380" height="130" as="geometry"/></mxCell><mxCell id="p_2_0" value="2.0 PENJUALAN &amp; PIUTANG&#xa;&#xa;• SPH Keluar &amp; Sales Order Barang&#xa;• Rekap Sales Order Barang&#xa;• Laporan Penjualan&#xa;• Surat Jalan Pengiriman (SJ) &amp; Pelunasan Piutang" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=11;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="460" y="230" width="380" height="130" as="geometry"/></mxCell><mxCell id="p_3_0" value="3.0 OPERASIONAL PRODUKSI&#xa;&#xa;• Order Produksi (tabel orders) &amp; BOM Manufaktur&#xa;• Data SOPd (/data/excel-sopd - Referensi Order)&#xa;• Input Target Penjadwalan JHP &amp; Target Harian&#xa;• Realisasi JHP (Web &amp; Bot) serta Laporan Pekerjaan" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=11;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="880" y="230" width="500" height="130" as="geometry"/></mxCell><mxCell id="p_4_0" value="4.0 KALKULASI &amp; PRICELIST&#xa;&#xa;• Simulator Pricelist (20+ Kategori Produk Cetak)&#xa;• Pencatatan Nilai HPP (/hpp-kalkulasi)&#xa;• Sync Nama Order dari Digit orders&#xa;• Referensi Tarif dari Rekap Pembelian Barang" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=11;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;" vertex="1" parent="1"><mxGeometry x="1420" y="230" width="360" height="130" as="geometry"/></mxCell><mxCell id="p_5_0" value="5.0 AKUNTANSI, SDM &amp; TATA KELOLA&#xa;&#xa;• Scrape Jurnal Umum &amp; Rek Akuntansi dari Digit&#xa;• Dashboard Akunting (Grafik Kas &amp; Laba-Rugi)&#xa;• Upload Karyawan &amp; Catat Kesalahan&#xa;• Manajemen Akun Pengguna, RBAC &amp; Log Aktivitas" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=11;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#f0fdfa;strokeColor=#0d9488;fontColor=#134e4a;" vertex="1" parent="1"><mxGeometry x="1820" y="230" width="365" height="130" as="geometry"/></mxCell><mxCell id="ds_d1" value="D1 | Data Pembelian&#xa;(purchase_requests, spph_out,&#xa;sph_in, purchase_orders,&#xa;penerimaan_pembelian,&#xa;rekap_pembelian_barang,&#xa;pelunasan_hutang)" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="185" height="110" as="geometry"/></mxCell><mxCell id="ds_d2" value="D2 | Master Stok&#xa;(stok_master_barang)" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="235" y="430" width="185" height="110" as="geometry"/></mxCell><mxCell id="ds_d3" value="D3 | Data Penjualan Digit&#xa;(sph_out, sales_orders, sales_reports, pengiriman, pelunasan_piutang)" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="460" y="430" width="380" height="110" as="geometry"/></mxCell><mxCell id="ds_d4" value="D4 | Produksi Digit&#xa;(bill_of_materials,&#xa;orders, bahan_baku,&#xa;barang_jadi,&#xa;produksi_selesai)" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="880" y="430" width="160" height="110" as="geometry"/></mxCell><mxCell id="ds_d5" value="D5 | Operasional SINTAK&#xa;(sopd, sopd_harga,&#xa;jurnal_harian_produksi,&#xa;master_pekerjaan)" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1050" y="430" width="160" height="110" as="geometry"/></mxCell><mxCell id="ds_d6" value="D6 | Laporan Pekerjaan&#xa;(laporan_pekerjaan -&#xa;log pekerjaan Setting,&#xa;Cetak, Finishing, QC)" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1220" y="430" width="160" height="110" as="geometry"/></mxCell><mxCell id="ds_d7" value="D7 | Kalkulasi Biaya &amp; Simulasi&#xa;(hpp_kalkulasi, saved_calculations, global_master_params)" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1420" y="430" width="360" height="110" as="geometry"/></mxCell><mxCell id="ds_d8" value="D8 | Akuntansi&#xa;(rek_akuntansi,&#xa;jurnal_umum)" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1820" y="430" width="115" height="110" as="geometry"/></mxCell><mxCell id="ds_d9" value="D9 | SDM &amp; Kasus&#xa;(employees,&#xa;infractions)" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1945" y="430" width="115" height="110" as="geometry"/></mxCell><mxCell id="ds_d10" value="D10 | Tata Kelola&#xa;(users, app_roles,&#xa;telegram_users,&#xa;activity_logs)" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2070" y="430" width="115" height="110" as="geometry"/></mxCell><mxCell id="p_audit" value="6.0 TRACKING MANUFAKTUR&#xa;&#xa;Pelacakan Alur Dokumen Operasional: Pengguna memasukkan No Faktur (BOM / Order Produksi / PO / PB / SO) → Sistem menelusuri alur dokumen otomatis:&#xa;Pembelian (PR → SPPH → SPH → PO → Penerimaan → Rekap PB → Hutang) ⇄ Penjualan (SPH Out → Sales Order → Laporan Penjualan → Kirim SJ → Piutang) ⇄ Pabrik (BOM → Order Produksi → Bahan Baku → Barang Jadi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4338ca;strokeColor=#312e81;fontColor=#ffffff;fontSize=10.5;fontStyle=1;align=center;verticalAlign=middle;shadow=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1340" height="80" as="geometry"/></mxCell><mxCell id="dash_support" value="DASHBOARD MONITORING SISTEM&#xa;&#xa;• Dashboard Akunting: Ringkasan Arus Kas, Laba/Rugi, &amp; Tren Akunting&#xa;• Dashboard HRD: Statistik Total Karyawan &amp; Grafik Tren Catat Kesalahan&#xa;• Dashboard Produksi: Ringkasan Order &amp; Jurnal, Tren BBB vs Hasil Produksi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#1e293b;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;shadow=1;spacing=6;" vertex="1" parent="1"><mxGeometry x="1420" y="660" width="765" height="80" as="geometry"/></mxCell><mxCell id="e_d1_p1" value="Scraping Pembelian" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1