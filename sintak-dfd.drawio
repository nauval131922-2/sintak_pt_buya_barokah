        <mxCell id="e4_digit_stok" parent="1" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;" value="DIGIT ERP: MASTER STOK&#10;(Kode, Barcode, Satuan &amp; Kelompok Barang)" vertex="1">
          <mxGeometry height="65" width="480" x="1600" y="95" as="geometry" />
        </mxCell>
        <mxCell id="p_1_1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;" value="1.1 PENGADAAN AWAL (PERMINTAAN &amp; PENAWARAN)&#10;&#10;• Scrape Purchase Request (PR: kebutuhan bahan baku/cetak)&#10;• Scrape SPPH (Surat Permintaan Penawaran Harga ke supplier)&#10;• Scrape SPH Masuk (Surat Penawaran Harga &amp; syarat pembayaran supplier)&#10;• Filter Status Pengadaan &amp; Tanggal Kebutuhan" vertex="1">
          <mxGeometry height="140" width="480" x="40" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p_1_2" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;" value="1.2 PEMESANAN &amp; PENERIMAAN FISIK&#10;&#10;• Scrape Purchase Order (PO resmi ke supplier terpilih)&#10;• Scrape Penerimaan Pembelian (Surat jalan masuk barang fisik)&#10;• Validasi Gudang Penerima &amp; Tanggal Kirim Supplier&#10;• Monitoring Status Selesai / Parsial Order Pembelian" vertex="1">
          <mxGeometry height="140" width="480" x="560" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p_1_3" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;" value="1.3 REKAP PEMBELIAN BARANG &amp; HUTANG&#10;&#10;• Scrape Rekap PB (Detail baris item: nama barang, qty, harga satuan)&#10;• Scrape Pelunasan Hutang (Bukti bayar, no rekening, tanggal bayar)&#10;• Menyediakan Sumber Data Lookup Harga Beli Bahan untuk Kalkulasi&#10;• Rekap Total Kewajiban Hutang Usaha per Supplier" vertex="1">
          <mxGeometry height="140" width="480" x="1080" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p_1_4" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;" value="1.4 PENGELOLAAN KATALOG MASTER STOK&#10;&#10;• Scrape Data Master Barang dari Digit (kode, barcode, nama barang)&#10;• Pemetaan Satuan &amp; Kode Kelompok Barang (kertas, tinta, plat, dll.)&#10;• Pencarian &amp; Filter Data Master Barang dari Digit&#10;• Read-Only Mirror Stok (SINTAK tidak menghitung mutasi stok fisik)" vertex="1">
          <mxGeometry height="140" width="480" x="1600" y="230" as="geometry" />
        </mxCell>
        <mxCell id="ds_1_d1_pra" parent="1" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" value="D1.1 | Dokumen Pengadaan Awal&#10;&#10;• purchase_requests (faktur, tgl_dibutuhkan, faktur_prd)&#10;• spph_out (faktur, faktur_pr, kd_supplier)&#10;• sph_in (faktur, top_hari, faktur_spph, status)" vertex="1">
          <mxGeometry height="120" width="480" x="40" y="460" as="geometry" />
        </mxCell>
        <mxCell id="ds_1_d1_po" parent="1" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" value="D1.2 | Dokumen Order &amp; Penerimaan&#10;&#10;• purchase_orders (faktur, tgl, faktur_sph, kd_supplier, total)&#10;• penerimaan_pembelian (faktur, tgl, faktur_po, kd_gudang)" vertex="1">
          <mxGeometry height="120" width="480" x="560" y="460" as="geometry" />
        </mxCell>
        <mxCell id="ds_1_d1_pb" parent="1" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" value="D1.3 | Rekap Tagihan &amp; Pelunasan Hutang&#10;&#10;• rekap_pembelian_barang (faktur_pb, nama_barang, qty, harga)&#10;• pelunasan_hutang (faktur, faktur_pb, tgl, jumlah_bayar)" vertex="1">
          <mxGeometry height="120" width="480" x="1080" y="460" as="geometry" />
        </mxCell>
        <mxCell id="ds_1_d2" parent="1" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" value="D2 | Master Stok Barang&#10;&#10;• stok_master_barang&#10;(kode, barcode, nama, satuan, kd_kelompok, kelompok)&#10;[Katalog Master Barang Read-Only]" vertex="1">
          <mxGeometry height="120" width="480" x="1600" y="460" as="geometry" />
        </mxCell>
        <mxCell id="out_1_track" parent="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#4338ca;strokeColor=#312e81;fontColor=#ffffff;" value="6.0 TRACKING MANUFAKTUR (/tracking-manufaktur)&#10;&#10;Pelacakan Alur Dokumen Pembelian Terpadu:&#10;PR ⇄ SPPH ⇄ SPH ⇄ PO ⇄ Penerimaan ⇄ Rekap PB ⇄ Pelunasan Hutang" vertex="1">
