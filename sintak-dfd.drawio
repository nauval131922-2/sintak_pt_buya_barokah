        <mxCell id="p_4_0" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;" value="4.0 KALKULASI &amp; PRICELIST&#xa;&#xa;• Simulator Pricelist (20+ Kategori Produk Cetak)&#xa;• Pencatatan Nilai HPP (/hpp-kalkulasi)&#xa;• Sync Nama Order dari Digit orders&#xa;• Referensi Tarif dari Rekap Pembelian Barang" vertex="1">
