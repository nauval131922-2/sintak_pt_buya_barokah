" height="50" as="geometry"/></mxCell><mxCell id="e2_kalkulasi_act" value="ROLE KALKULASI &amp;&#xa;MANAJEMEN TUGAS" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;" vertex="1" parent="1"><mxGeometry x="1420" y="110" width="360" height="50" as="geometry"/></mxCell><mxCell id="e2_keu_admin" value="ROLE AKUNTING, HRD,&#xa;&amp; SUPER ADMIN" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#f0fdfa;strokeColor=#0d9488;fontColor=#134e4a;" vertex="1" parent="1"><mxGeometry x="1820" y="110" width="360" height="50" as="geometry"/></mxCell><mxCell id="p_1_0" value="1.0 PEMBELIAN &amp; STOK&#xa;&#xa;• Tarik Data PR, SPPH, SPH Masuk, PO&#xa;• Penerimaan Pembelian Gudang &amp; Rekap PB&#xa;• Pencatatan &amp; Pelunasan Hutang&#xa;• Sinkronisasi Stok Master Barang (12.9k Item)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=11;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="380" height="130" as="geometry"/></mxCell><mxCell id="p_2_0" value="2.0 PENJUALAN &amp; PIUTANG&#xa;&#xa;• SPH Keluar &amp; Sales Order Barang&#xa;• Viewer Rekap Sales Order&#xa;• Laporan Penjualan Realisasi&#xa;• Surat Jalan Pengiriman &amp; Pelunasan Piutang" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=11;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="460" y="230" width="380" height="130" as="geometry"/></mxCell><mxCell id="p_3_0" value="3.0 OPERASIONAL MANUFAKTUR &amp; JHP&#xa;&#xa;• Order Produksi (tabel orders) &amp; BOM Manufaktur&#xa;• Data SOPd (/data/excel-sopd - Referensi Order)&#xa;• Master Pekerjaan (Referensi Dropdown Mesin/Bagian)&#xa;• Pencatatan JHP (Realisasi, Inscheet, Rijek, Kendala)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=11;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="880" y="230" width="500" height="130" as="geometry"/></mxCell><mxCell id="p_4_0" value="4.0 KALKULASI BIAYA &amp; LAPORAN TUGAS&#xa;&#xa;• Input Tugas Teknis Divisi (/laporan-pekerjaan)&#xa;• Simulator Pricelist (20+ Kategori Produk Cetak)&#xa;• Estimasi HPP Cetak &amp; Sync Bahan Order Produksi&#xa;• Rekap Lookup Harga Riil Kertas &amp; Plat Vendor" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=11;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;" vertex="1" parent="1"><mxGeometry x="1420" y="230" width="360" height="130" as="geometry"/></mxCell><mxCell id="p_5_0" value="5.0 AKUNTANSI, SDM &amp; TATA KELOLA&#xa;&#xa;• Scrape Jurnal Umum (100k) &amp; Rek Akuntansi (203)&#xa;• Dashboard Akunting (Grafik Kas &amp; Tren Laba-Rugi)&#xa;• Upload Karyawan (154 Staf) &amp; Catat Kesalahan&#xa;• Manajemen Akun Pengguna, RBAC &amp; Audit Log" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=11;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#f0fdfa;strokeColor=#0d9488;fontColor=#134e4a;" vertex="1" parent="1"><mxGeometry x="1820" y="230" width="360" height="130" as="geometry"/></mxCell><mxCell id="ds_d1" value="D1 | Data Pembelian Digit&#xa;(purchase_requests, spph_out, sph_in, purchase_orders, penerimaan_pembelian, rekap_pembelian_barang, pelunasan_hutang)" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9.5;fontStyle=1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="430"