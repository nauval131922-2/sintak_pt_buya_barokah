        <mxCell id="e3_kasi_supervisor" parent="1" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" value="KEPALA SEKSI &amp; SUPERVISOR:&#xa;Monitoring Produksi &amp; Analisa Order" vertex="1">
          <mxGeometry height="65" width="440" x="1180" y="95" as="geometry" />
        </mxCell>
        <mxCell id="e3_operator_tek" parent="1" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#fdf4ff;strokeColor=#c026d3;fontColor=#701a75;" value="OPERATOR LAPANGAN &amp; KEPALA SEKSI:&#xa;Divisi Setting, QC, Cetak, Finishing, Gudang, Teknisi, Mesin" vertex="1">
          <mxGeometry height="65" width="480" x="1670" y="95" as="geometry" />
        </mxCell>
        <mxCell id="p_3_1" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;" value="3.1 SINKRONISASI DATA PRODUKSI DIGIT&#xa;&#xa;• Scrape Bill of Material (BOM)&#xa;• Scrape Order Produksi (faktur, tgl, deadline, status)&#xa;• Scrape Pemakaian Bahan Baku (BBB)&#xa;• Scrape Barang Jadi &amp; Produksi Selesai" vertex="1">
          <mxGeometry height="140" width="300" x="40" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p_3_2" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;" value="3.2 PENGELOLAAN DATA REFERENSI PRODUKSI&#xa;&#xa;• Referensi Order: Otomatis dari Digit orders (Arsip ≤ 2024 via Excel)&#xa;• Master Pekerjaan: Unggah Kode, Kategori &amp; Target Standar&#xa;• Master Pekerjaan JHP: Kelola Nama Pekerjaan Dropdown JHP&#xa;• Menyediakan Opsi Dropdown Dinamis untuk Form JHP" vertex="1">
          <mxGeometry height="140" width="310" x="390" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p_3_3" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;" value="3.3 PENJADWALAN &amp; PENCATATAN REALISASI JHP&#xa;&#xa;• Form Penjadwalan: Shift, Operator, No Order, Target &amp; Jam&#xa;• Form Web Realisasi: Lembar Jadi, Inscheet, Rijek, Kendala&#xa;• Webhook Telegram Bot: Input Realisasi Lapangan Berbasis Order&#xa;• Validasi Akun Telegram &amp; Tanggal Input (Maks 7 Hari)" vertex="1">
          <mxGeometry height="140" width="380" x="750" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p_3_4" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" value="3.4 ANALISA &amp; MONITORING PRODUKSI&#xa;&#xa;• Laporan Harian: Lembar Shift Kerja Lapangan &amp; Cetak Jadwal (/target)&#xa;• Analisa Order: Lacak Kronologi &amp; Kendala Pengerjaan per No Order (/analisa)&#xa;• Hasil Produksi: Hitung Akumulasi Lembar JHP vs Data Barang Jadi Digit (/hasil-produksi)&#xa;• Dashboard Manufaktur: Visualisasi Grafik Tren Pemakaian Bahan vs Hasil" vertex="1">
          <mxGeometry height="140" width="440" x="1180" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p_3_5" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#fdf4ff;strokeColor=#c026d3;fontColor=#701a75;" value="3.5 PELAPORAN TUGAS LAPANGAN (LAPORAN PEKERJAAN)&#xa;&#xa;• Input Task 7 Divisi: Setting, QC, Cetak, Finishing, Gudang, Teknisi, Mesin&#xa;• Rujukan Proyek: Baca No Order dari Referensi Orders / SOPd&#xa;• Pengelolaan Status Tugas: Belum Dikerjakan, In Progress, Selesai, Cancel&#xa;• Hak Akses Terpisah: Dikelola per role divisi teknis" vertex="1">
          <mxGeometry height="140" width="480" x="1670" y="230" as="geometry" />
        </mxCell>
        <mxCell id="ds_3_d4" parent="1" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" value="D4 | Produksi Digit&#xa;&#xa;• bill_of_materials (faktur, formula)&#xa;• orders (faktur_prd, tgl, deadline, status)&#xa;• bahan_baku (faktur_pb, pemakaian)&#xa;• barang_jadi &amp; produksi_selesai" vertex="1">
          <mxGeometry height="120" width="300" x="40" y="460" as="geometry" />
        </mxCell>
        <mxCell id="ds_3_ref" parent="1" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;strokeColor=#059669;fillColor=#ecfdf5;" value="DATA REFERENSI PRODUKSI&#xa;&#xa;• orders / sopd (nama_order otomatis dari Digit)&#xa;• master_pekerjaan (kode &amp; target standar)&#xa;• master_pekerjaan_jurnal_produksi (opsi form JHP)&#xa;[Hanya Dibaca sebagai Dropdown &amp; Standar]" vertex="1">
          <mxGeometry height="120" width="310" x="390" y="460" as="geometry" />
