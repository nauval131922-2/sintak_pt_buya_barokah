  <diagram id="dfd_level_2_kalkulasi" name="DFD Level 2 - 4.0 Kalkulasi &amp; Pricelist">
    <mxGraphModel dx="1422" dy="798" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="820" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="b6_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#1e293b;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2020" height="60" as="geometry" /></mxCell><mxCell id="b6_txt" value="DATA FLOW DIAGRAM (DFD) LEVEL 2 - PROSES 4.0: KALKULASI BIAYA &amp; PRICELIST&#10;PT BUYA BAROKAH" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2020" height="60" as="geometry" /></mxCell><mxCell id="e6_act_lookup" value="ROLE SINTAK: KALKULASI&#10;(Cek Tarif Pembelian Riil Bahan Kertas)" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="620" height="65" as="geometry" /></mxCell><mxCell id="e6_act_kalkulasi" value="ROLE SINTAK: KALKULASI&#10;(Input Parameter Oplah, Bahan Kertas, Mesin &amp; Finishing)" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;" vertex="1" parent="1"><mxGeometry x="730" y="95" width="620" height="65" as="geometry" /></mxCell><mxCell id="e6_act_hpp" value="ROLE SINTAK: KALKULASI&#10;(Pencatatan &amp; Pembaruan Nilai Rupiah HPP per Order)" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;" vertex="1" parent="1"><mxGeometry x="1420" y="95" width="620" height="65" as="geometry" /></mxCell><mxCell id="p_4_1" value="4.1 LOOKUP RIWAYAT HARGA BELI BAHAN (/pricelist/rekap-lookup)&#10;&#10;• Membaca Data Historis Pembelian dari Tabel rekap_pembelian_barang (D1.3)&#10;• Deteksi Otomatis Gramatur Kertas (HVS, Art Paper, Art Carton) &amp; Ukuran Plano (cm)&#10;• Konversi Cerdas Nilai Rupiah ke Estimasi Harga per Kg, per Rim, atau per Lembar&#10;• Menyediakan Modal Popup Pencarian Cepat di Form Simulator Pricelist" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="620" height="140" as="geometry" /></mxCell><mxCell id="p_4_2" value="4.2 SIMULASI PERHITUNGAN BIAYA CETAK (/pricelist)&#10;&#10;• Mesin Hitung 20+ Kategori Produk: Buku Soft/Hard Cover, Kalender Kop, Nota, Majalah, Undangan, dll.&#10;• Perhitungan 4 Komponen Biaya: Kertas/Bahan + Plat/Ongkos Cetak Mesin + Finishing + Markup Profit&#10;• Rekomendasi Pilihan Ukuran Plano Kertas Paling Efisien (Meminimalkan Kertas Terbuang)&#10;• Fitur Simpan Hasil Hitungan Custom &amp; Ekspor Matriks Harga ke Database" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;" vertex="1" parent="1"><mxGeometry x="730" y="230" width="620" height="140" as="geometry" /></mxCell><mxCell id="p_4_3" value="4.3 PENCATATAN NILAI HPP PER ORDER (/hpp-kalkulasi)&#10;&#10;• Sinkronisasi Otomatis Nama Order Baru dari Tabel orders Digit (nama_prd)&#10;• Tabel Master Input: Pengisian Nilai Rupiah HPP per Nama Order (Web Inline Edit)&#10;• Fitur Impor &amp; Rekonsiliasi Massal dari File Excel HPP&#10;• Rujukan Biaya Pokok Produksi untuk Evaluasi Margin Keuntungan Penjualan" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;" vertex="1" parent="1"><mxGeometry x="1420" y="230" width="620" height="140" as="geometry" /></mxCell><mxCell id="box_6_note" value="SUMBER DATA TARIF BAHAN:&#10;&#10;• Dibaca secara dinamis dari tabel rekap_pembelian_barang (D1.3)&#10;• Filter berdasarkan barcode, kode barang, dan supplier riil&#10;[Query Dinamis: Pencarian Riwayat Pembelian Tanpa Tabel Tambahan]" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f8fafc;strokeColor=#475569;fontSize=8.5;fontStyle=0;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="620" height="120" as="geometry" /></mxCell><mxCell id="ds_4_d7_price" value="D7.1 | Matriks &amp; Riwayat Kalkulasi Pricelist&#10;&#10;• pricelist_items (jenis_kalender, oplah, proses, bahan, ukuran, hpp, harga, profit)&#10;• pricelist_saved_calculations (category, title, oplah, params_snapshot, data, created_by)" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="730" y="460" width="620" height="120" as="geometry" /></mxCell><mxCell id="ds_4_d7_hpp" value="D7.2 | Master Nilai HPP Kalkulasi&#10;&#10;• hpp_kalkulasi&#10;(id, nama_order, hpp_kalkulasi, keterangan, created_at, updated_at)&#10;[Sinkronisasi Nama Order Otomatis dari Tabel orders Digit]" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1420" y="460" width="620" height="120" as="geometry" /></mxCell><mxCell id="out_4_lookup_ui" value="MODAL REKAP LOOKUP (/pricelist/rekap-lookup)&#10;&#10;Pop-up Pencarian Tarif Beli Bahan Riil Saat Mengisi Simulator Pricelist" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#581c87;strokeColor=#3b0764;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="620" height="80" as="geometry" /></mxCell><mxCell id="out_4_pricelist_ui" value="SIMULATOR PRICELIST &amp; RIWAYAT TERSIMPAN (/pricelist)&#10;&#10;• Matriks Penawaran Harga Jual per Oplah untuk Pelanggan&#10;• Daftar Kalkulasi Tersimpan (Bisa Dibuka Kembali &amp; Diedit Ulang)" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#0f172a;strokeColor=#1e293b;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="730" y="680" width="620" height="80" as="geometry" /></mxCell><mxCell id="out_4_hpp_ui" value="TABEL MASTER HPP KALKULASI (/hpp-kalkulasi)&#10;&#10;Pencatatan Nilai Rupiah HPP per Pesanan Produksi &amp; Pencarian Cepat Nama Order" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#065f46;strokeColor=#064e3b;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1420" y="680" width="620" height="80" as="geometry" /></mxCell><mxCell id="e_act_p41" value="Pencarian Kata Kunci Bahan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e6_act_lookup" target="p_4_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_act_p42" value="Input Oplah, Bahan &amp; Finishing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e6_act_kalkulasi" target="p_4_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_act_p43" value="Input / Upload Excel Nilai HPP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e6_act_hpp" target="p_4_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_p41_p42" value="Referensi Tarif&amp;#xa;Beli Kertas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;fontSize=8;fontColor=#047857;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;" edge="1" parent="1" source="p_4_1" target="p_4_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_p42_d7" value="Simpan Matriks &amp; Riwayat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_4_2" target="ds_4_d7_price"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_p43_d7" value="Simpan Master HPP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_4_3" target="ds_4_d7_hpp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_p41_ui" value="Tampilan Hasil Lookup Bahan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="box_6_note" target="out_4_lookup_ui"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d7price_ui" value="Penyajian Matriks &amp; Kalkulasi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ds_4_d7_price" target="out_4_pricelist_ui"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d7hpp_ui" value="Penyajian Master HPP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ds_4_d7_hpp" target="out_4_hpp_ui"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="dfd_level_2_tata_kelola" name="DFD Level 2 - 5.0 Akuntansi, SDM &amp; Tata Kelola">
    <mxGraphModel dx="1422" dy="798" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="820" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="b7_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#1e293b;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2020" height="60" as="geometry"/></mxCell><mxCell id="b7_txt" value="DATA FLOW DIAGRAM (DFD) LEVEL 2 - PROSES 5.0: AKUNTANSI, SDM &amp; TATA KELOLA&#xa;PT BUYA BAROKAH" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2020" height="60" as="geometry"/></mxCell><mxCell id="e7_act_akunting" value="ROLE SINTAK: AKUNTING &amp; DIGIT ERP:&#xa;(Scrape Jurnal Umum &amp; Rek Akuntansi dari Digit)" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#f0fdfa;strokeColor=#0d9488;fontColor=#134e4a;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="620" height="65" as="geometry"/></mxCell><mxCell id="e7_act_hrd" value="ROLE SINTAK: HRD:&#xa;(Upload Data Karyawan &amp; Input Catat Kesalahan)" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="730" y="95" width="620" height="65" as="geometry"/></mxCell><mxCell id="e7_act_superadmin" value="ROLE SINTAK: SUPER ADMIN:&#xa;(Kelola Pengguna, Hak Akses, Approval Bot &amp; Audit Log)" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1420" y="95" width="620" height="65" as="geometry"/></mxCell><mxCell id="p_5_1" value="5.1 PENGELOLAAN AKUNTANSI &amp; JURNAL UMUM&#xa;&#xa;• Scrape Jurnal Umum (faktur, tgl, rekening, debit, kredit, keterangan)&#xa;• Scrape Rekening Akuntansi (kode rekening &amp; keterangan COA)&#xa;• Modal Analisis Jurnal: Filter Mutasi Debit/Kredit per Rekening Akuntansi&#xa;• Ekspor Laporan Jurnal ke File Excel &amp; Rekap Saldo Kas/Bank" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#f0fdfa;strokeColor=#0d9488;fontColor=#134e4a;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="620" height="140" as="geometry"/></mxCell><mxCell id="p_5_2" value="5.2 PENGELOLAAN SDM &amp; CATAT KESALAHAN&#xa;&#xa;• Kelola Data Karyawan (Upload Excel, Nama, Posisi, Bagian, Status Aktif)&#xa;• Pencatatan Kesalahan Kerja Karyawan di /records (Tanggal, Poin, Keterangan)&#xa;• Integrasi Dropdown Operator: Nama Karyawan Aktif Dipakai pada Form JHP&#xa;• Rekapitulasi Data Pelanggaran Kerja per Individu &amp; per Bagian" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="730" y="230" width="620" height="140" as="geometry"/></mxCell><mxCell id="p_5_3" value="5.3 TATA KELOLA PENGGUNA, HAK AKSES &amp; AUDIT LOG&#xa;&#xa;• Manajemen Akun Pengguna (/users: Tambah Akun, Password, Status Aktif)&#xa;• Konfigurasi Hak Akses (/roles: Pengaturan Izin Menu per Role Pengguna)&#xa;• Persetujuan Registrasi Bot Telegram (/settings/telegram-users)&#xa;• Scrape Log Digit (/data-digit/sistem/log-aktivitas-user: Tabel usr_log)&#xa;• Perekaman Otomatis Audit Log Aktivitas Sistem (/activity-log)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;shadow=1;fontSize=10.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1420" y="230" width="620" height="140" as="geometry"/></mxCell><mxCell id="ds_5_d8" value="D8 | Akuntansi&#xa;&#xa;• rek_akuntansi (kode, keterangan, kelompok)&#xa;• jurnal_umum (faktur, tgl, rekening, keterangan, debit, kredit)&#xa;[Sinkronisasi Transaksi Keuangan dari Digit]" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="620" height="120" as="geometry"/></mxCell><mxCell id="ds_5_d9" value="D9 | SDM &amp; Catat Kesalahan&#xa;&#xa;• employees (id, name, position, department, is_active)&#xa;• infractions (id, employee_id, description, points, date)&#xa;[Master Data Personalia &amp; Catatan Kesalahan Kerja]" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="730" y="460" width="620" height="120" as="geometry"/></mxCell><mxCell id="ds_5_d10" value="D10 | Tata Kelola&#xa;&#xa;• users &amp; app_roles (akun pengguna &amp; daftar peran)&#xa;• role_permissions (matriks izin akses modul)&#xa;• telegram_users (registrasi bot &amp; approval)&#xa;• activity_logs &amp; usr_log (audit trail sistem &amp; log Digit)" style="shape=partialRectangle;top=0;bottom=0;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1420" y="460" width="620" height="120" as="geometry"/></mxCell><mxCell id="out_5_akunting_ui" value="DASHBOARD AKUNTING &amp; JURNAL UMUM&#xa;(/dashboard-akunting &amp; /akuntansi/laporan/jurnal-umum)&#xa;&#xa;• Grafik Tren Kas, Laba/Rugi, dan Jurnal Transaksi Terbaru&#xa;• Modal Analisis Jurnal per Rekening Akuntansi &amp; Ekspor Excel" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#134e4a;strokeColor=#042f2e;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="620" height="80" as="geometry"/></mxCell><mxCell id="out_5_hrd_ui" value="DASHBOARD HRD &amp; CATAT KESALAHAN&#xa;(/dashboard-hrd &amp; /records &amp; /karyawan)&#xa;&#xa;• Statistik Total Karyawan Aktif &amp; Grafik Tren Catat Kesalahan&#xa;• Tabel Daftar Karyawan dan Riwayat Catatan Kesalahan Kerja" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#713f12;strokeColor=#451a03;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="730" y="680" width="620" height="80" as="geometry"/></mxCell><mxCell id="out_5_admin_ui" value="PANEL PENGATURAN SISTEM &amp; AUDIT LOG&#xa;(/roles &amp; /users &amp; /settings/telegram-users &amp; /activity-log)&#xa;&#xa;• Antarmuka Kelola Pengguna, Hak Akses, Approval Bot, dan Viewer Log" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fontSize=9.5;fontStyle=1;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#0f172a;strokeColor=#1e293b;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1420" y="680" width="620" height="80" as="geometry"/></mxCell><mxCell id="e_act_p51" value="Trigger Scrape &amp; Parameter Jurnal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e7_act_akunting" target="p_5_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_act_p52" value="Input Data Karyawan &amp; Kesalahan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e7_act_hrd" target="p_5_2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_act_p53" value="Kelola Akun, Izin &amp; Approval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e7_act_superadmin" target="p_5_3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_p51_d8" value="Simpan Jurnal &amp; Rekening" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_5_1" target="ds_5_d8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_p52_d9" value="Simpan Karyawan &amp; Catat Kesalahan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_5_2" target="ds_5_d9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_p53_d10" value="Simpan User, Role, Izin &amp; Log" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_5_3" target="ds_5_d10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_d8_ui" value="Visualisasi Dashboard &amp; Analisis Jurnal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ds_5_d8" target="out_5_akunting_ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_d9_ui" value="Visualisasi Dashboard HRD &amp; Catatan Kesalahan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ds_5_d9" target="out_5_hrd_ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_d10_ui" value="Penyajian Manajemen Pengguna &amp; Audit Trail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=8.5;fontColor=#0369a1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ds_5_d10" target="out_5_admin_ui"><mxGeometry relative="1" as="geometry"/></mxCell>
