        <mxCell id="box_3_source" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fefce8;strokeColor=#ca8a04;fontSize=8.5;fontStyle=0;align=left;spacingLeft=8;spacingTop=6;" value="SUMBER DATA ANALISIS &amp; MONITORING:&#10;&#10;• Data Log Transaksi Riil dibaca dari Data Store D5&#10;• Data Barang Jadi Pembanding dibaca dari Data Store D4&#10;[Query Dinamis: Agregasi Lembar Jadi, Rijek &amp; Tren Mesin]" vertex="1">
          <mxGeometry height="120" width="440" x="1180" y="460" as="geometry" />
